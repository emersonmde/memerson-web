{
  "name": "memerson-web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run build && node --test tests/*.test.ts",
    "test:unit": "node --test tests/rail.test.ts tests/content.test.ts tests/manifest.test.ts",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,json,md}\"",
    "deploy": "npm run build && wrangler deploy",
    "photos:import": "node scripts/photos/import.mjs",
    "photos:shoots": "node scripts/photos/shoots.mjs",
    "photos:describe": "node scripts/photos/describe.mjs",
    "photos:name-shoots": "node scripts/photos/name-shoots.mjs",
    "photos:verify": "node scripts/photos/verify.mjs",
    "photos:rebuild": "node scripts/photos/rebuild.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.13.3",
    "exifr": "^7.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.114.0"
  }
}
