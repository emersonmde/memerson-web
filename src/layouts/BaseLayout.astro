---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_URL } from '../consts';
import Sky from '../components/Sky.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

/**
 * Neon District. Design system in docs/UI-DESIGN.md; tokens in
 * src/styles/global.css. Desktop-only by decision — see UI-DESIGN §9.
 */
interface Props {
  title: string;
  description?: string;
  active?: 'systems' | 'photos' | 'log' | 'about';
  /** Shooting stars are hero-only, so they default off. */
  shooting?: boolean;
  /** Inner pages point the wordmark back home. */
  back?: boolean;
  /** Pages that supply their own footer (the home page's contact block). */
  footer?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  active,
  shooting = false,
  back = false,
  footer = true,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {
      /*
      `viewport-fit=cover` lets the page paint into the rounded corners, the
      Dynamic Island notch and the home-indicator strip, which is the only way
      the star field, the footer horizon and the viewer's bloom reach the edges
      of the screen instead of stopping at a black band. Content is kept out of
      those regions by the `env(safe-area-inset-*)` padding in global.css —
      `--nav-h` folds the top inset in, so every sticky offset follows.
    */
    }
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#03040a" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#03040a" />

    <title>{title} | {SITE_TITLE}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/icon.png', SITE_URL).href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content={new URL('/icon.png', SITE_URL).href} />

    <link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />

    <!-- Self-hosted; nothing here reaches a third party. UI-DESIGN §3. -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* Mockup 6g, "Redraw". See docs/UI-DESIGN.md §5.5. */}
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">SKIP TO CONTENT</a>

    <Sky shooting={shooting} />

    <SiteHeader active={active} back={back} />

    <div class="page">
      <main id="main">
        <slot />
      </main>

      {footer && <SiteFooter />}
    </div>

    <div class="scanlines" aria-hidden="true"></div>
    <div class="redraw" aria-hidden="true"></div>

    <script>
      import '../scripts/fx';
      import '../scripts/redraw';
    </script>
  </body>
</html>
