---
import { SITE_TITLE } from '../consts';

/**
 * The labels and the hrefs differ on purpose: blog slugs are a contract that has
 * to survive the errorsignal.dev redirect in M2, so the URL cannot become /log.
 * See docs/UI-DESIGN.md §7.
 *
 * The first item was SYSTEMS, from the mockup, back when `/` was a page of
 * projects. It is now a landing page carrying projects, photographs and writing,
 * and calling the whole thing SYSTEMS named only its first third. HOME is the
 * plainest thing that is true, and the one label a visitor never has to decode.
 */
interface Props {
  /** Which nav item is the current section. */
  active?: 'home' | 'photos' | 'log' | 'about';
  /** Home shows the wordmark; inner pages show it as a way back. */
  back?: boolean;
}

const { active, back = false } = Astro.props;

const LINKS = [
  { key: 'home', label: 'HOME', href: '/' },
  { key: 'photos', label: 'PHOTOS', href: '/photos' },
  { key: 'log', label: 'LOG', href: '/blog' },
  { key: 'about', label: 'ABOUT', href: '/about' },
] as const;
---

<nav class="nav" aria-label="Main">
  <a class="nav-mark" href="/">{back ? '← ' : ''}M.EMERSON</a>
  {
    LINKS.map((link) => (
      <a
        href={link.href}
        aria-current={active === link.key ? 'page' : undefined}
        title={link.key === 'log' ? `Writing by ${SITE_TITLE}` : undefined}
      >
        {link.label}
      </a>
    ))
  }
</nav>
{
  /*
    The nav's lower falloff (`.nav-fade`) is deliberately *not* here. It has to
    paint above ordinary page content but below the sticky section headers, and
    `.page` is a stacking context — a body-level fade would cover those too and
    dim their top edge. It lives inside `.page` in BaseLayout instead.
  */
}
