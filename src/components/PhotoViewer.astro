---
/**
 * The photo viewer (lightbox). Inert until `src/scripts/photoViewer.ts` wires
 * it up — that script reparents it to <body>, fills every empty element here,
 * and owns all of its behavior. Extracted from the gallery page wholesale; the
 * rendered DOM is the contract the script and the e2e suite both read, so a
 * change here is a change there.
 *
 * The styles are `is:global` on purpose. The no-new-nodes constraint is about
 * script-built elements (the tags and thumbnails are createElement'd at
 * runtime, and a scope attribute would never reach them) — not about which
 * file the CSS lives in.
 */
---

<div class="lb" data-lb role="dialog" aria-modal="true" aria-label="Photo viewer" hidden>
  <div class="lb-wash" data-lb-close></div>
  <div class="lb-bloom">
    <div class="lb-bloom-layer" data-bloom-layer></div>
    <div class="lb-bloom-layer" data-bloom-layer></div>
  </div>
  <div class="lb-vignette"></div>
  <div class="lb-bar">
    <span class="lb-counter"></span>
    <button type="button" class="lb-close" data-lb-close>
      CLOSE <span class="lb-close-key">ESC</span> ×
    </button>
  </div>
  <div class="lb-stage">
    <button type="button" class="lb-nav" data-lb-step="-1" aria-label="Previous photo">
      ←
    </button>
    <figure class="lb-frame">
      {
        /* No <picture>: a <source> would override the cached URL the script
      paints first, which is the whole point of the sequence. */
      }
      <img class="lb-img" alt="" />
    </figure>
    <button type="button" class="lb-nav" data-lb-step="1" aria-label="Next photo">
      →
    </button>
  </div>
  <aside class="lb-exif" data-lb-exif aria-label="Capture data">
    {
      /* An h2, not h3: with the viewer open the page's visible outline is
    the h1 and this — a jump to h3 is the one thing axe finds. */
    }
    <h2>
      CAPTURE DATA
      {
        /* Expression children, not text: prettier would pad a one-line text
          child with spaces the compiler keeps, and the DOM must stay
          byte-identical to what the page shipped before the extraction. */
      }
      <button type="button" class="lb-exif-close" data-lb-exif-close>{'CLOSE ×'}</button>
    </h2>
    <dl></dl>
  </aside>
  <div class="lb-foot">
    <div class="lb-foot-inner">
      <div>
        <div class="lb-titleline">
          <div class="lb-title"></div>
        </div>
        <div class="lb-meta">
          <span class="lb-dash"></span>
          <button type="button" class="lb-shoot"></button>
          <span class="lb-meta-text"></span>
          {
            /* Widest served derivative, straight from R2. Cross-origin, so
           no `download` attribute — it opens in a tab, which is the
           right behaviour anyway (look, then save). */
          }
          <a class="lb-full" target="_blank" rel="noopener">{'FULL RES'}</a>
        </div>
        <div class="lb-tags"></div>
      </div>
      <div class="lb-right">
        {/* Keyboard hints where there is a keyboard; real controls on touch. */}
        <div class="lb-hint">
          <span>
            <b>I</b> CAPTURE DATA
          </span>
          <span>
            <b>← →</b> MOVE
          </span>
        </div>
        <div class="lb-thumbs"></div>
        <div class="lb-controls">
          <button
            type="button"
            class="lb-step"
            data-lb-step="-1"
            aria-label="Previous photo"
          >
            ←
          </button>
          <button type="button" class="lb-step" data-lb-step="1" aria-label="Next photo">
            →
          </button>
          <button
            type="button"
            class="btn-ghost lb-info"
            aria-pressed="false"
            aria-label="Capture data"
          >
            i
          </button>
        </div>
      </div>
    </div>
    <div class="lb-swipe">SWIPE ← → TO MOVE &nbsp;·&nbsp; SWIPE DOWN TO CLOSE</div>
  </div>
</div>

<style is:global>
  /* -------------------------------------------------------------------------
   * Lightbox
   * ---------------------------------------------------------------------- */

  /*
   * The viewer is the one full-screen surface on the site, so it is where
   * `viewport-fit=cover` matters most: the wash and the bloom run edge to edge
   * under the notch and the home indicator, and only the chrome is inset.
   */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 40;
    --lb-t: env(safe-area-inset-top, 0px);
    --lb-b: env(safe-area-inset-bottom, 0px);
    /*
     * How far the backdrop layers run past the fixed box.
     *
     * A `position: fixed` element is laid out against the *small* viewport on
     * iOS — the area between the status bar and the floating tab bar — so a
     * wash at `inset: 0` stops dead at both, and the strips behind Safari's
     * translucent chrome show the page underneath instead of the viewer. The
     * layers themselves are not clipped (nothing here sets `overflow`), so
     * running them past the box is all it takes: the pixels land in the strips
     * and the backdrop reads as one continuous surface under the notch and the
     * home indicator. 220px clears the tallest of either.
     */
    --lb-over: 220px;
    /*
     * The photograph's budget on a pointer viewport, and the one place it is
     * stated. `sizeFrame()` in the script writes the frame's width as
     * `min(--lb-w-cap, --lb-h-cap * aspect)` and gives the footer the same
     * expression, which is what keeps the title and the thumbnail strip aligned
     * to the image's own edges however the window is shaped.
     *
     * The width cap was a flat 900px, which on a wide window left the viewer
     * showing a *smaller* photograph than the editorial lead behind it. It is
     * now the stage's own width — 60px of padding plus two 40px arrows and their
     * 24px gaps — under a ceiling at 2048px, past which the 5120 derivative
     * (the library's widest rung) starts being upscaled on a 2× display. The
     * ceiling was 1600px when the rungs stopped at 2560; it moved with them
     * (2026-07-31) so a big screen actually receives the large tier. No slack
     * is subtracted for a classic scrollbar 100vw counts and the layout does
     * not: the frame's `max-width: 100%` is measured against the stage and
     * clamps that case.
     *
     * The height cap budgets the vertical chrome: the 52px bar, the stage's own
     * 14px, the 156px reserved for the metadata stack, and ~18px of breathing
     * so the frame never looks wedged between the two. It is deliberately not
     * the whole stage: the bloom is the photograph's own light spilling past it
     * and needs somewhere to spill.
     */
    --lb-w-cap: min(2048px, calc(100vw - 188px));
    --lb-h-cap: calc(100vh - 240px - var(--lb-t) - var(--lb-b));
    animation: lbIn 0.24s cubic-bezier(0.2, 0.85, 0.2, 1);
  }

  .lb[hidden] {
    display: none;
  }

  /*
   * Ambient bloom — a blurred, saturated copy of the photograph sitting behind
   * itself. No colour is ever extracted or stored; the glow *is* the photo.
   */
  /*
   * Two layers cross-fading by opacity, not one layer transitioning its
   * background-image. The single-layer version was soft in Blink and WebKit
   * (they cross-fade background-image) but Gecko treats the property as
   * discrete, so the "transition" there was just the old bloom held for
   * 225ms — and in every engine the old photograph stayed on screen for the
   * whole fade. Opacity fades the same 450ms everywhere, the incoming light
   * is correct from its first frame, and the blur sits on each layer so a
   * swap rasterizes one surface once instead of re-blurring every frame of
   * the fade. See docs/PERFORMANCE.md §4.8.
   */
  .lb-bloom {
    position: absolute;
    inset: -12%;
    opacity: 0.95;
    transform: scale(1.2);
    pointer-events: none;
  }

  .lb-bloom-layer {
    position: absolute;
    inset: 0;
    background-position: center;
    background-size: cover;
    filter: blur(70px) saturate(2.2) brightness(1.35);
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  /*
   * The base backdrop. The bloom stacks *above* this — putting the wash on top
   * drowns the bloom entirely. DOM order is wash → bloom → vignette.
   */
  .lb-wash {
    position: absolute;
    inset: calc(-1 * var(--lb-over)) 0;
    background: rgba(3, 4, 10, 0.82);
  }

  /*
   * The box overruns the viewport but the gradient must not be stretched with
   * it, or the falloff lands off-screen and the vignette all but disappears.
   * So the radial is sized back to the visible band and centred in it, and the
   * overrun strips are filled by two flat layers of the gradient's own terminal
   * value. They meet at exactly the same colour, so there is no seam.
   *
   * The strips are *layers*, not `background-color`: a colour paints across the
   * whole box, including the band, so it sat behind the radial's transparent
   * centre at 0.88 and dimmed the bloom into invisibility. A transparent stop
   * over an opaque background-colour is not transparent.
   */
  .lb-vignette {
    position: absolute;
    inset: calc(-1 * var(--lb-over)) 0;
    pointer-events: none;
    --lb-edge: rgba(3, 4, 10, 0.88);
    background-image:
      radial-gradient(72% 58% at 50% 46%, transparent, var(--lb-edge) 78%),
      linear-gradient(var(--lb-edge), var(--lb-edge)),
      linear-gradient(var(--lb-edge), var(--lb-edge));
    background-size:
      100% calc(100% - 2 * var(--lb-over)),
      100% var(--lb-over),
      100% var(--lb-over);
    background-position:
      50% 50%,
      50% 0,
      50% 100%;
    background-repeat: no-repeat;
  }

  .lb-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(52px + var(--lb-t));
    display: flex;
    align-items: center;
    justify-content: space-between;
    /*
     * One shorthand. `padding-top: var(--lb-t)` followed by `padding: 0 30px`
     * resets the top inset back to zero, which is what put CLOSE under the
     * Dynamic Island with its focus ring and its `×` clipped by the status bar.
     */
    padding: var(--lb-t) 30px 0;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
  }

  .lb-counter {
    color: var(--cyan);
  }

  .lb-close {
    background: none;
    border: 0;
    padding: 0;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
    cursor: pointer;
    transition: color 0.16s;
  }

  .lb-close:hover {
    color: #fff;
  }

  .lb-close-key {
    color: var(--faint);
  }

  .lb-stage {
    position: absolute;
    inset: calc(52px + var(--lb-t)) 0 calc(156px + var(--lb-b));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 14px 30px 0;
    transition: right 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* The drawer pushes the frame rather than covering it. */
  .lb.exif-open .lb-stage {
    right: 292px;
  }

  .lb-nav {
    flex: none;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(220, 240, 255, 0.18);
    background: none;
    color: #c2cee0;
    cursor: pointer;
    font: 400 13px var(--mono);
    transition: all 0.16s;
  }

  .lb-nav:hover {
    border-color: #fff;
    color: #fff;
    box-shadow: 0 0 22px -8px #fff;
  }

  /*
   * The frame wears the tile's LQIP while the full image is on the wire.
   *
   * Without it the viewer arrived in three separate events — an unsized image
   * laying out at the wrong place, then jumping as its intrinsic size landed,
   * then the bloom appearing behind it. The LQIP is a ~200-byte data URI that is
   * already in the document, so it costs no request and paints in the same frame
   * as everything else. The full image then resolves over it, which is the same
   * blur-to-sharp the headings and the tiles already use.
   */
  .lb-frame {
    position: relative;
    margin: 0;
    /* The cap lives on the image (see `--lb-w-cap`); this is only the hard stop
       that keeps the frame inside the stage — including when the capture-data
       drawer slides in and narrows it. */
    max-width: 100%;
    max-height: 100%;
    transform-origin: top left;
    background-size: cover;
    background-position: center;
    box-shadow: 0 34px 90px -30px rgba(0, 0, 0, 0.95);
  }

  .lb-img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /*
   * There are no crop marks on the viewer's frame.
   *
   * There were — one bracket per corner, in the outing's point on the accent
   * ramp — and they were the tile's hover marks carried inward. On the sheet
   * that mark is doing work: it says *this tile is the one you are pointing at*
   * among a hundred others. In the viewer there is one photograph, nothing to
   * disambiguate, and the bloom already draws the frame's edge in the
   * photograph's own light. The brackets were a second, contradicting edge on
   * top of it, and the one piece of chrome touching the image.
   *
   * The tile keeps its `--bk`; the viewer no longer sets one. The footer's tube
   * still burns `--run` — the shoot's own light — so the outing is still named
   * in colour, just not by drawing on the photograph.
   */

  .lb-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 96px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 30px calc(18px + var(--lb-b));
  }

  /* The script overwrites `width` with the frame's own expression so the two
     edges line up; 900px is what a viewer without JavaScript would never see. */
  .lb-foot-inner {
    width: var(--lb-w-cap, 900px);
    max-width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .lb-titleline {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .lb-title {
    max-width: 520px;
    font: 700 24px var(--display);
    letter-spacing: -0.025em;
    color: var(--tx-hi);
  }

  .lb-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.18em;
    color: var(--dim);
  }

  /* The tube beside the shoot name is the run header's fitting, so it burns in
     the same `--run` as that shoot's date on the page — not the crop marks'
     `--bk`, and not a fixed cyan. */
  .lb-dash {
    width: 20px;
    height: 2px;
    background: var(--run, var(--cyan));
    box-shadow: 0 0 10px var(--run, var(--cyan));
  }

  .lb-shoot {
    font: 500 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: var(--sodium);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 0.16s;
  }

  .lb-shoot:hover {
    color: var(--tx-hi);
  }

  /* The take-it-with-you link: the widest rung we serve, in a new tab. A
     bordered rectangle so it reads as a control among the plain-text meta —
     the same plate treatment the tags use, at meta-line scale. */
  .lb-full {
    font: 500 9px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
    border: 1px solid rgba(220, 240, 255, 0.18);
    padding: 4px 8px;
    text-decoration: none;
    transition: all 0.16s;
  }

  .lb-full:hover,
  .lb-full:focus-visible {
    color: var(--tx-hi);
    border-color: #fff;
    box-shadow: 0 0 18px -8px #fff;
  }

  /* Tags are the one thing that makes 390 of them navigation rather than decor. */
  .lb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 11px;
    max-width: 560px;
  }

  .lb-tag {
    font: 400 9px var(--mono);
    letter-spacing: 0.1em;
    color: var(--dim-4);
    background: none;
    border: 1px solid rgba(142, 180, 255, 0.16);
    padding: 3px 8px;
    cursor: pointer;
    transition: all 0.16s;
  }

  .lb-tag:hover {
    color: var(--void);
    background: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 20px -6px var(--cyan);
  }

  .lb-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }

  .lb-hint {
    display: flex;
    gap: 12px;
    font: 400 8.5px var(--mono);
    letter-spacing: 0.18em;
    color: var(--faint-2);
  }

  .lb-hint b {
    color: var(--faint);
    font-weight: 400;
  }

  .lb-thumbs {
    display: flex;
    gap: 7px;
  }

  /*
   * Swipe is the gesture, but a gesture with no visible affordance is a secret.
   * These are the same two actions the arrows give a mouse, in the row that was
   * otherwise empty next to `i`.
   */
  .lb-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lb-step {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(220, 240, 255, 0.18);
    background: none;
    color: #c2cee0;
    cursor: pointer;
    font: 400 15px var(--mono);
  }

  .lb-step:active {
    border-color: #fff;
    color: #fff;
  }

  /* Dim until hovered — the same "one thing lights at a time" rule as the sheet. */
  .lb-thumb {
    width: 64px;
    height: 44px;
    padding: 0;
    border: 0;
    background-color: var(--ink);
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    cursor: pointer;
    transition: opacity 0.16s;
  }

  .lb-thumb:hover {
    opacity: 1;
  }

  .lb-thumb[aria-current='true'] {
    opacity: 1;
    outline: 1px solid rgba(255, 255, 255, 0.9);
    outline-offset: 1px;
    box-shadow: 0 0 18px -4px #fff;
  }

  /*
   * Capture data, hidden until `i`. Never on by default: half the library is a
   * phone, where the settings were not an authored decision — the note below
   * says so rather than dressing an auto-exposure up as craft.
   */
  .lb-exif {
    position: absolute;
    top: 70px;
    right: 30px;
    width: 250px;
    z-index: 3;
    padding: 16px 18px;
    border: 1px solid var(--hairline);
    background: rgba(8, 11, 19, 0.95);
    opacity: 0;
    transform: translateX(14px);
    pointer-events: none;
    transition:
      opacity 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .lb-exif.is-open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .lb-exif h2 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 12px;
    font: 500 9px var(--mono);
    letter-spacing: 0.26em;
    color: var(--faint);
  }

  /*
   * The panel needs its own way out. On the bottom-sheet layout it covers the
   * `i` that opened it, which left no way to dismiss it at all.
   */
  .lb-exif-close {
    display: none;
    font: 500 9px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
    background: none;
    border: 1px solid var(--hairline);
    padding: 8px 12px;
    cursor: pointer;
  }

  .lb-exif dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 7px 14px;
    margin: 0;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.08em;
  }

  .lb-exif dt {
    color: var(--faint);
  }

  .lb-exif dd {
    margin: 0;
    color: var(--tx);
    text-align: right;
  }

  .lb-swipe {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 10px);
    text-align: center;
    font: 400 8.5px var(--mono);
    letter-spacing: 0.22em;
    color: var(--faint-2);
  }
</style>

<style is:global>
  /* -------------------------------------------------------------------------
   * Small screens. The viewer's share of the gallery's responsive story —
   * see docs/UI-DESIGN.md §9 and the gallery page for the px-* half.
   * ---------------------------------------------------------------------- */

  /* ---------- 900: desktop chrome stops fitting ---------- */
  @media (max-width: 900px) {
    /*
     * The metadata stack goes vertical here rather than at 720, so the
     * thumbnails can stay: they are the only thing on the page that says there
     * are other photographs to get to, and dropping them for one breakpoint
     * band and bringing them back for the next would be the wrong kind of
     * responsive.
     */
    .lb-foot-inner {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .lb-right {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      width: 100%;
    }

    .lb-thumbs {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .lb-thumbs::-webkit-scrollbar {
      display: none;
    }

    /* The metadata stack went vertical above, so it reserves more room — and the
       frame's height budget has to follow it or the two overlap. */
    .lb-stage {
      inset: calc(52px + var(--lb-t)) 0 calc(190px + var(--lb-b));
    }

    .lb {
      --lb-h-cap: calc(100vh - 274px - var(--lb-t) - var(--lb-b));
    }
  }

  /* ---------- 720: two rows of controls, touch sizing ---------- */
  @media (max-width: 720px) {
    /* Arrows and the thumbnail strip are mouse furniture; swipe replaces both. */
    .lb-bar {
      height: calc(48px + var(--lb-t));
      padding: var(--lb-t) var(--gutter) 0;
    }

    .lb-close {
      min-height: 44px;
      display: flex;
      align-items: center;
    }

    .lb-nav {
      display: none;
    }

    .lb-stage {
      /*
       * The bottom inset is the metadata stack's *measured* height, written by
       * `sizeFrame()` as `--lb-foot-h`. The 196px fallback was the old fixed
       * reserve, and it was a lie whenever a title wrapped or tags showed —
       * portrait frames ran under the footer and the chrome printed on the
       * photograph. Landscape phones keep their fixed inset below.
       */
      inset: calc(48px + var(--lb-t)) 0 var(--lb-foot-h, calc(196px + var(--lb-b)));
      padding: 8px var(--gutter) 0;
      align-items: center;
    }

    .lb.exif-open .lb-stage {
      right: 0;
    }

    .lb-frame {
      max-width: 100%;
      width: 100%;
    }

    .lb-img {
      width: 100%;
      height: auto;
      max-height: 100%;
      margin: 0 auto;
    }

    .lb-foot {
      min-height: 0;
      padding: 0 var(--gutter) calc(18px + var(--lb-b));
    }

    .lb-title {
      font-size: 19px;
      max-width: none;
    }

    .lb-meta {
      margin-top: 6px;
      font-size: 9px;
      letter-spacing: 0.14em;
    }

    /* Eight tags would wrap to four lines; scroll them instead. */
    .lb-tags {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-top: 10px;
      max-width: none;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .lb-tags::-webkit-scrollbar {
      display: none;
    }

    .lb-tag {
      flex: none;
      padding: 7px 10px;
      min-height: 36px;
