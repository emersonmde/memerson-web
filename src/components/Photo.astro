---
import { getEntry } from 'astro:content';
import { PHOTOS_BASE_URL } from '../consts';

interface Props {
  /** Photo slug from the manifest, e.g. "2022-03-14-a3f9c1b2". */
  id: string;
  /** Overrides the manifest caption. */
  caption?: string;
  /** Defaults to full content width; pass a real value when the layout is known. */
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { id, caption, sizes = '100vw', loading = 'lazy' } = Astro.props;

const photo = await getEntry('photos', id);

// A bad slug is a build error, not a runtime 404 — the whole reason photos are a
// collection rather than a plain array. See docs/ARCHITECTURE.md §7.
if (!photo) {
  throw new Error(
    `<Photo id="${id}" /> — no such photo in src/data/photos.json. ` +
      `Run \`npm run photos:import <path>\` and use the slug it prints.`,
  );
}

const { width, height, variants, formats, lqip } = photo.data;
const text = caption ?? photo.data.caption;

// No titles or captions exist yet — they get backfilled over time (see
// docs/ARCHITECTURE.md §6). Until then `alt=""` would mark every gallery image
// decorative, which is wrong: they are the content. Fall back to the date the
// manifest already knows rather than shipping 118 unlabelled images.
const takenAt = photo.data.takenAt;
const alt =
  photo.data.title ??
  text ??
  (takenAt
    ? `Photograph taken ${takenAt.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      })}`
    : 'Photograph');

const srcSet = (format: string) =>
  variants.map((w) => `${PHOTOS_BASE_URL}/photos/${id}/${w}.${format} ${w}w`).join(', ');

const widest = Math.max(...variants);
const fallback = `${PHOTOS_BASE_URL}/photos/${id}/${widest}.webp`;
---

<figure>
  <picture>
    {
      formats.includes('avif') && (
        <source type="image/avif" srcset={srcSet('avif')} sizes={sizes} />
      )
    }
    {
      formats.includes('webp') && (
        <source type="image/webp" srcset={srcSet('webp')} sizes={sizes} />
      )
    }
    <img
      src={fallback}
      width={width}
      height={height}
      alt={alt}
      loading={loading}
      decoding="async"
      style={`background-image:url(${lqip});background-size:cover;`}
    />
  </picture>
  {text && <figcaption>{text}</figcaption>}
</figure>

<style>
  /*
   * A gallery photo dropped into a post. It breaks the 68ch prose measure on
   * purpose — the text column is for reading and a photograph is not text, so
   * it gets the wider frame and the corner brackets the rest of the system
   * uses for "this is a thing, not a paragraph".
   */
  figure {
    position: relative;
    margin: 34px 0;
    max-width: 900px;
  }

  figure::before,
  figure::after {
    content: '';
    position: absolute;
    width: 14px;
    height: 14px;
    pointer-events: none;
  }

  figure::before {
    left: -1px;
    top: -1px;
    border-left: 1px solid var(--cyan);
    border-top: 1px solid var(--cyan);
  }

  figure::after {
    right: -1px;
    bottom: -1px;
    border-right: 1px solid var(--cyan);
    border-bottom: 1px solid var(--cyan);
  }

  img {
    width: 100%;
    height: auto;
    display: block;
  }

  figcaption {
    margin-top: 10px;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.16em;
    color: var(--faint);
    text-transform: uppercase;
  }
</style>
