---
import type { CollectionEntry } from 'astro:content';
import { PHOTOS_BASE_URL } from '../consts';
import { photoAlt } from '../lib/photoAlt';

/**
 * A gallery thumbnail. Used by both the home
 * page preview strip and the contact sheet.
 *
 * Unlike <Photo>, this emits no <figure>/<figcaption> — it is a tile in a grid,
 * and its label is chrome rather than a caption.
 */
interface Props {
  photo: CollectionEntry<'photos'>;
  sizes: string;
  /** Overlay label, bottom-left. */
  label?: string;
  /** Fixed height for the masonry sheet; omitted, the tile keeps aspect ratio. */
  height?: string;
  /** Hover-revealed metadata, top-right. */
  meta?: string;
  /** Index within the page, for the lightbox to address. */
  index?: number;
  loading?: 'lazy' | 'eager';
  /**
   * Where the tile goes when clicked. Defaults to the full-size derivative,
   * which is what the contact sheet wants: the lightbox intercepts the click,
   * and without JS you still get the photograph.
   *
   * The home page's preview strip overrides this to `/photos` — there is no
   * lightbox there, so the default would strand the visitor on a bare image
   * file with no navigation back.
   */
  href?: string;
}

const { photo, sizes, label, height, meta, index, loading = 'lazy', href } = Astro.props;
const { id, variants, formats, lqip, aspectRatio } = photo.data;

const srcSet = (format: string) =>
  variants.map((w) => `${PHOTOS_BASE_URL}/photos/${id}/${w}.${format} ${w}w`).join(', ');

const widest = Math.max(...variants);
const full = `${PHOTOS_BASE_URL}/photos/${id}/${widest}.webp`;

/*
 * The lightbox's ambient bloom is a blurred copy of the photograph itself, so
 * the smallest derivative is the right source: it gets blurred to 80px anyway,
 * and it is already in cache from the tile. Loading the 2560px version to throw
 * away every detail would be pure waste.
 */
const smallest = Math.min(...variants);
const bloom = `${PHOTOS_BASE_URL}/photos/${id}/${smallest}.webp`;

const alt = photoAlt(photo);
---

{
  /*
  The tile is a real link to the full image, so it works with no JS at all.
  The lightbox intercepts the click and reuses these data attributes rather
  than duplicating the manifest into a second payload on the page.
*/
}
<a
  class="tile"
  href={href ?? full}
  data-tile
  data-index={index}
  data-avif={formats.includes('avif') ? srcSet('avif') : undefined}
  data-webp={formats.includes('webp') ? srcSet('webp') : undefined}
  data-alt={alt}
  data-label={label}
  data-meta={meta}
  data-bloom={bloom}
  data-ar={aspectRatio}
  style={`--ar:${aspectRatio};${height ? `--h:${height};` : ''}`}
>
  <picture>
    {
      formats.includes('avif') && (
        <source type="image/avif" srcset={srcSet('avif')} sizes={sizes} />
      )
    }
    {
      formats.includes('webp') && (
        <source type="image/webp" srcset={srcSet('webp')} sizes={sizes} />
      )
    }
    <img
      src={full}
      alt={alt}
      loading={loading}
      decoding="async"
      style={`background-image:url(${lqip});background-size:cover;background-position:center`}
    />
  </picture>
  <span class="tile-wash" aria-hidden="true"></span>
  {label && <span class="tile-label">{label}</span>}
  {meta && <span class="tile-meta">{meta}</span>}
</a>

<style>
  .tile {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--ink);
    transition:
      transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.2s;
  }

  .tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 54px -18px var(--cyan);
  }

  /*
   * Two sizing modes from one rule. With --h set (the masonry sheet) the fixed
   * height wins and aspect-ratio is ignored, because width and height are both
   * definite. With --h unset, `height` is invalid at computed-value time and
   * falls back to auto, leaving aspect-ratio in charge. Either way the ratio
   * comes from the manifest, so no tile ever reflows when the image lands.
   */
  .tile img {
    width: 100%;
    height: var(--h);
    aspect-ratio: var(--ar);
    object-fit: cover;
    display: block;
  }

  /*
   * The mockup dims every tile to 60% black and lights one on hover. That reads
   * well with placeholder gradients and badly with photographs: a contact sheet
   * exists to be *browsed*, and a grid of uniformly murky images defeats the
   * one job it has.
   *
   * Inverted here. A trace of wash keeps the tiles seated against the near-black
   * page rather than glaring off it; hover clears it completely. The "one tile
   * lights" idea survives as a lift in contrast, not as a penalty on the other
   * twenty-nine.
   */
  .tile-wash {
    position: absolute;
    inset: 0;
    background: rgba(3, 4, 10, 0.18);
    transition: background 0.2s;
    pointer-events: none;
  }

  .tile:hover .tile-wash {
    background: transparent;
  }

  /*
   * Chrome, not caption — so it appears on hover with the rest of the metadata
   * rather than sitting permanently on top of the photograph. The date is still
   * in the image's alt text, so nothing is lost to a screen reader.
   */
  .tile-label {
    position: absolute;
    left: 9px;
    bottom: 7px;
    font: 400 8.5px var(--mono);
    letter-spacing: 0.14em;
    color: #c7d2e2;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
    text-shadow: 0 1px 6px rgba(3, 4, 10, 0.9);
  }

  .tile:hover .tile-label {
    opacity: 1;
  }

  .tile-meta {
    position: absolute;
    right: 9px;
    top: 8px;
    font: 400 8px var(--mono);
    letter-spacing: 0.12em;
    color: #c7d2e2;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
    text-shadow: 0 1px 6px rgba(3, 4, 10, 0.9);
  }

  .tile:hover .tile-meta {
    opacity: 1;
  }
</style>
