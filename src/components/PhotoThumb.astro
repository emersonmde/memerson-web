---
import type { CollectionEntry } from 'astro:content';
import { photoAlt } from '../lib/photoAlt';
import { srcSetFor, widestUrl } from '../lib/photoUrls';

/**
 * A gallery thumbnail — the home page's preview strip. The gallery's own unit
 * is `PhotoTile`, which carries the metadata the lightbox reads; this one has
 * no lightbox behind it and carries nothing a script would consume.
 *
 * Unlike <Photo>, this emits no <figure>/<figcaption> — it is a tile in a grid,
 * and its label is chrome rather than a caption.
 */
interface Props {
  photo: CollectionEntry<'photos'>;
  sizes: string;
  /** Overlay label, bottom-left. */
  label?: string;
  /** Hover-revealed metadata, top-right. */
  meta?: string;
  loading?: 'lazy' | 'eager';
  /**
   * Where the tile goes when clicked. Defaults to the full-size derivative;
   * the home page overrides this to `/photos#f-<slug>`, which lands on the
   * frame in the gallery — there is no lightbox here, so the default would
   * strand the visitor on a bare image file with no navigation back.
   */
  href?: string;
}

const { photo, sizes, label, meta, loading = 'lazy', href } = Astro.props;
const { id, variants, formats, lqip, aspectRatio } = photo.data;

const srcSet = (format: string) => srcSetFor(id, variants, format);
const full = widestUrl(id, variants);

const alt = photoAlt(photo);
---

<a class="tile" href={href ?? full} style={`--ar:${aspectRatio};`}>
  <picture>
    {
      formats.includes('avif') && (
        <source type="image/avif" srcset={srcSet('avif')} sizes={sizes} />
      )
    }
    {
      formats.includes('webp') && (
        <source type="image/webp" srcset={srcSet('webp')} sizes={sizes} />
      )
    }
    <img
      src={full}
      alt={alt}
      loading={loading}
      decoding="async"
      style={`background-image:url(${lqip});background-size:cover;background-position:center`}
    />
  </picture>
  <span class="tile-wash" aria-hidden="true"></span>
  {label && <span class="tile-label">{label}</span>}
  {meta && <span class="tile-meta">{meta}</span>}
</a>

<style>
  .tile {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--ink);
    transition:
      transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.2s;
  }

  .tile:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 54px -18px var(--cyan);
  }

  /* The ratio comes from the manifest, so no tile reflows when the image lands. */
  .tile img {
    width: 100%;
    aspect-ratio: var(--ar);
    object-fit: cover;
    display: block;
  }

  /*
   * The mockup dims every tile to 60% black and lights one on hover. That reads
   * well with placeholder gradients and badly with photographs: a contact sheet
   * exists to be *browsed*, and a grid of uniformly murky images defeats the
   * one job it has.
   *
   * Inverted here. A trace of wash keeps the tiles seated against the near-black
   * page rather than glaring off it; hover clears it completely. The "one tile
   * lights" idea survives as a lift in contrast, not as a penalty on the other
   * twenty-nine.
   */
  .tile-wash {
    position: absolute;
    inset: 0;
    background: rgba(3, 4, 10, 0.18);
    transition: background 0.2s;
    pointer-events: none;
  }

  .tile:hover .tile-wash {
    background: transparent;
  }

  /*
   * Chrome, not caption — so it appears on hover with the rest of the metadata
   * rather than sitting permanently on top of the photograph. The date is still
   * in the image's alt text, so nothing is lost to a screen reader.
   */
  .tile-label {
    position: absolute;
    left: 9px;
    bottom: 7px;
    font: 400 8.5px var(--mono);
    letter-spacing: 0.14em;
    color: var(--dim-5);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
    text-shadow: 0 1px 6px rgba(3, 4, 10, 0.9);
  }

  .tile:hover .tile-label {
    opacity: 1;
  }

  .tile-meta {
    position: absolute;
    right: 9px;
    top: 8px;
    font: 400 8px var(--mono);
    letter-spacing: 0.12em;
    color: var(--dim-5);
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
    text-shadow: 0 1px 6px rgba(3, 4, 10, 0.9);
  }

  .tile:hover .tile-meta {
    opacity: 1;
  }
</style>
