---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoThumb from '../components/PhotoThumb.astro';
import { AUTHOR } from '../consts';
import { hueForIndex } from '../lib/ramp';
import { readingTime } from '../lib/readingTime';

/** Mockup 6a. See docs/UI-DESIGN.md §7. */

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const photos = (await getCollection('photos')).sort(
  (a, b) => (b.data.takenAt?.valueOf() ?? 0) - (a.data.takenAt?.valueOf() ?? 0),
);

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const PREVIEW_PHOTOS = 4;
const PREVIEW_POSTS = 3;

const teasePhotos = photos.slice(0, PREVIEW_PHOTOS);
const remainingPhotos = photos.length - teasePhotos.length;

const previewPosts = posts.slice(0, PREVIEW_POSTS);
const remainingPosts = posts.length - previewPosts.length;

// The mockup's "05 ALBUMS" has no data behind it; the year span does.
const years = photos
  .map((p) => p.data.takenAt?.getUTCFullYear())
  .filter(Boolean) as number[];
const yearSpan = years.length ? `${Math.min(...years)} — ${Math.max(...years)}` : '';

const pad = (n: number) => String(n).padStart(2, '0');
const railHue = (index: number) => hueForIndex(index, projects.length);

const projectLinks = (p: (typeof projects)[number]) =>
  [
    { label: 'SOURCE ↗', href: p.data.github },
    p.data.demo ? { label: 'DEMO ↗', href: p.data.demo } : null,
    p.data.docs ? { label: 'DOCS ↗', href: p.data.docs } : null,
    p.data.crate ? { label: 'CRATE ↗', href: p.data.crate } : null,
  ].filter(Boolean) as { label: string; href: string }[];

const photoMeta = (p: (typeof photos)[number]) =>
  [p.data.camera, p.data.aperture, p.data.shutter]
    .filter(Boolean)
    .join(' · ')
    .toUpperCase();

const isoDate = (d: Date | null) =>
  d ? d.toLocaleDateString('en-CA', { timeZone: 'UTC' }).replace(/-/g, '.') : '';
---

<BaseLayout
  title={AUTHOR.name}
  description={`${AUTHOR.name}, ${AUTHOR.summary} at Amazon. Side projects, photographs, and writing.`}
  active="home"
  shooting={true}
>
  <section class="hero">
    <div class="hero-fx" aria-hidden="true">
      <div class="haze" data-fx="haze"></div>
      <div class="haze-2"></div>
      <div class="shaft" data-fx="shaft"></div>
      <div class="hero-floor"></div>
    </div>

    <div class="hero-body">
      {
        /* This read `MEMERSON.COM — DISTRICT 09 / PERSONAL`, which was the
          mockup's placeholder flavour and not a reference to anything. The
          kicker is the first line on the site, so it now spends itself saying
          what the site holds. The references that stayed are the ones that mean
          something: the project names, and the footer's lunar coordinates. */
      }
      <div class="kicker">MEMERSON.COM · PROJECTS, PHOTOS, WRITING</div>

      <div class="sign-wrap">
        <h1 class="sign">M.EMERSON</h1>
        <div class="sign-echo" aria-hidden="true">M.EMERSON</div>
      </div>

      <div class="tube-row">
        <div class="tube" aria-hidden="true">
          <span class="tube-elbow"></span>
          <span class="tube-bar"><span class="tube-spec"></span></span>
          <span class="tube-cap"></span>
        </div>
        <span class="tube-note">SCROLL ↓</span>
      </div>

      <div class="bio">
        <div class="bio-tube" aria-hidden="true"></div>
        <div class="bio-row">
          <p>
            {AUTHOR.name}, {AUTHOR.summary} at Amazon, leading engineers and applied scientists
            on LLM and agentic systems for hiring. {projects.length} projects below, written
            after hours, mostly in Rust.
          </p>
          <div class="bio-langs">RUST · C<br />JAVA · PYTHON<br />TYPESCRIPT</div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-rail" data-rail-scope>
    <div class="sec-head">
      <span class="sec-num" style="--n:var(--sodium)">01</span>
      <span class="sec-rule"></span>
      <span class="sec-name">PROJECTS</span>
      <a class="sec-aside" href="https://github.com/emersonmde">ALL REPOS ON GITHUB ↗</a>
    </div>

    <div class="rail-track" aria-hidden="true"></div>
    <div class="rail-glow" data-fx="rail" aria-hidden="true">
      <span class="rail-bloom"></span>
      <div class="rail-live"></div>
    </div>
    <div class="rail-head" data-fx="head" aria-hidden="true"></div>
    <div class="rail-terminal" data-fx="terminal" aria-hidden="true"></div>

    <div class="rows">
      {
        projects.map((project, i) => (
          <div class="row" data-row style={`--h:${railHue(i)}`}>
            <span class="node" data-dot data-fx="node" aria-hidden="true" />
            <span class="offshoot" data-off aria-hidden="true" />

            <details class="plate">
              <span class="plate-charge" aria-hidden="true" />
              <span class="bracket bracket-tl" aria-hidden="true" />
              <span class="bracket bracket-tr" aria-hidden="true" />
              <span class="bracket bracket-bl" aria-hidden="true" />
              <span class="bracket bracket-br" aria-hidden="true" />

              <summary>
                <span class="plate-head">
                  <span class="plate-num">{pad(i + 1)}</span>
                  <span class="plate-name">{project.data.name}</span>
                  <span class="plate-blurb">{project.data.shortDescription}</span>
                </span>
                <span class="plate-mark" aria-hidden="true" />

                <div class="plate-tags">
                  {project.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </summary>

              <div class="plate-detail">
                <p>{project.data.description}</p>
                <div class="plate-links">
                  {projectLinks(project).map((link) => (
                    <a class="btn-ghost" href={link.href}>
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </details>
          </div>
        ))
      }

      <div class="rail-end"><span class="rail-end-rule"></span>END OF LINE</div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <span class="sec-num" style="--n:var(--cyan)">02</span>
      <span class="sec-rule"></span>
      <span class="sec-name">PHOTOGRAPHS</span>
      <span class="sec-aside">{photos.length} FRAMES · {yearSpan}</span>
    </div>

    <a class="sec-title" data-fx="resolve" href="/photos">Photographs</a>

    <div class="sec-lede">
      {
        /* The header carries the numbers; this line carries the shape of the
          thing. Ledes state what a section is and how it is organised — never
          who it was for or what gear was involved. A subject inventory reads
          like a caption, and a gear apology reads worse. */
      }
      <p>The full gallery, grouped by shoot.</p>
      <a class="sec-aside" href="/photos">ALL {photos.length} FRAMES ↗</a>
    </div>

    <div class="tease">
      {
        teasePhotos.map((photo) => (
          <PhotoThumb
            photo={photo}
            sizes="170px"
            label={isoDate(photo.data.takenAt)}
            meta={photoMeta(photo)}
            href={`/photos#f-${photo.id}`}
          />
        ))
      }
      <a class="tease-more" href="/photos">
        <span class="tease-more-n">+{remainingPhotos}</span>
        <span class="tease-more-l">CONTACT SHEET ↗</span>
      </a>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <span class="sec-num" style="--n:var(--violet)">03</span>
      <span class="sec-rule"></span>
      <span class="sec-name">THE LOG</span>
      <a class="sec-aside" href="/rss.xml">{posts.length} POSTS · RSS ↗</a>
    </div>

    <a class="sec-title" data-fx="resolve" href="/blog">The log</a>

    <div class="sec-lede sec-lede-narrow">
      <p>Occasional write-ups from the projects above.</p>
      <a class="sec-aside" href="/blog">ALL {posts.length} POSTS ↗</a>
    </div>

    <div class="log-preview">
      {
        previewPosts.map((post) => (
          <a class="log-row" href={`/blog/${post.id}`}>
            <span class="log-date">{isoDate(post.data.date)}</span>
            <span class="log-title">{post.data.title}</span>
            <span class="log-read">{readingTime(post.body)}</span>
          </a>
        ))
      }
      {
        remainingPosts > 0 && (
          <a class="log-all" href="/blog">
            <span>READ THE FULL LOG · {remainingPosts} MORE</span>
            <span class="log-all-arrow">↗</span>
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------------ hero */

  .hero {
    position: relative;
    padding: 112px var(--gutter) 0;
  }

  .hero-fx {
    position: absolute;
    left: 0;
    right: 0;
    top: -52px;
    height: 760px;
    overflow: hidden;
    pointer-events: none;
  }

  /* Nebula is hero-only: the one place it can be strong without fighting text. */
  .haze {
    position: absolute;
    inset: -25%;
    background: radial-gradient(
      closest-side at 24% 42%,
      oklch(0.55 0.2 288 / 0.42),
      transparent 68%
    );
    filter: blur(38px);
  }

  .haze-2 {
    position: absolute;
    inset: -25%;
    background: radial-gradient(
      closest-side at 78% 26%,
      oklch(0.8 0.18 200 / 0.2),
      transparent 66%
    );
    filter: blur(34px);
    animation: fogSlow 40s ease-in-out infinite;
  }

  .shaft {
    position: absolute;
    left: 27%;
    top: -18%;
    width: 18%;
    height: 118%;
    background: linear-gradient(180deg, oklch(0.8 0.18 200 / 0.12), transparent 74%);
    filter: blur(13px);
  }

  .hero-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    background: linear-gradient(180deg, transparent, var(--void));
  }

  .hero-body {
    position: relative;
  }

  .kicker {
    font: 500 10px var(--mono);
    letter-spacing: 0.3em;
    color: var(--faint);
    margin-bottom: 22px;
  }

  /*
   * Sized to the word rather than a fixed measure. The mockup hard-coded 600px
   * to fit "EMERSON"; "M.EMERSON" overruns that, and a literal width would have
   * to be re-guessed every time the wordmark changes.
   */
  .sign-wrap {
    position: relative;
    width: fit-content;
  }

  .sign {
    margin: 0;
    font: 700 116px/0.9 var(--display);
    letter-spacing: -0.055em;
    color: var(--tx-hi);
    text-shadow:
      -1.5px 0 0 oklch(0.68 0.26 348 / 0.3),
      1.5px 0 0 oklch(0.8 0.18 200 / 0.36),
      0 0 16px oklch(0.8 0.18 200 / 0.5),
      0 0 70px oklch(0.8 0.18 200 / 0.36);
    animation: neonFlicker 15s steps(1, end) infinite;
  }

  /* Wet-floor echo. */
  .sign-echo {
    font: 700 116px/0.9 var(--display);
    letter-spacing: -0.055em;
    color: var(--tx-hi);
    text-shadow: 0 0 16px oklch(0.8 0.18 200 / 0.8);
    transform: scaleY(-1);
    opacity: 0.13;
    filter: blur(2.6px);
    mask-image: linear-gradient(transparent 46%, #000);
    -webkit-mask-image: linear-gradient(transparent 46%, #000);
    height: 74px;
    overflow: hidden;
  }

  .tube-row {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-top: 16px;
    height: 18px;
  }

  .tube {
    position: relative;
    flex: none;
    width: 518px;
    height: 18px;
  }

  .tube-elbow {
    position: absolute;
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
    border-top: 3px solid var(--sodium);
    border-left: 3px solid var(--sodium);
    border-top-left-radius: 18px;
    filter: drop-shadow(0 0 6px var(--sodium))
      drop-shadow(0 0 20px oklch(0.82 0.17 66 / 0.6));
  }

  .tube-bar {
    position: absolute;
    left: 18px;
    right: 12px;
    top: 0;
    height: 3px;
    border-radius: 2px;
    background: var(--sodium);
    box-shadow:
      0 0 9px var(--sodium),
      0 0 34px oklch(0.82 0.17 66 / 0.55);
    overflow: hidden;
  }

  /* Energy travels; the tube itself holds still. */
  .tube-spec {
    position: absolute;
    inset: -2px;
    background: linear-gradient(90deg, transparent, #fff7e6, transparent);
    background-size: 30% 100%;
    background-repeat: no-repeat;
    filter: blur(1.5px);
    animation: travel 6.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .tube-cap {
    position: absolute;
    right: 0;
    top: -6px;
    width: 6px;
    height: 15px;
    border-radius: 1px;
    background: linear-gradient(180deg, #5d6272, #20242e);
    box-shadow: 0 0 10px oklch(0.82 0.17 66 / 0.5);
  }

  .tube-note {
    font: 400 9.5px/1.5 var(--mono);
    letter-spacing: 0.2em;
    color: var(--faint);
    white-space: nowrap;
  }

  .bio {
    position: relative;
    padding: 34px 0 66px var(--rail-offset);
  }

  .bio-tube {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 2px;
    background: var(--sodium);
    box-shadow:
      0 0 9px oklch(0.82 0.17 66 / 0.75),
      0 0 30px oklch(0.82 0.17 66 / 0.35);
  }

  .bio-row {
    display: flex;
    align-items: flex-end;
    gap: 34px;
  }

  .bio-row p {
    margin: 0;
    max-width: 540px;
    font: 400 14px/1.8 var(--mono);
    color: #94a2b8;
    text-wrap: pretty;
  }

  .bio-langs {
    font: 400 10px/1.9 var(--mono);
    letter-spacing: 0.14em;
    color: var(--faint);
    border-left: 1px solid rgba(142, 180, 255, 0.16);
    padding-left: 16px;
  }

  /* --------------------------------------------------------------- systems */

  .sec-rail {
    padding-bottom: 86px;
  }

  /*
   * The run starts at the very top of the section, i.e. *behind* the sticky
   * header, so the charge emerges from under it rather than appearing in open
   * space below it.
   */
  .rail-track,
  .rail-glow,
  .rail-live {
    position: absolute;
    left: var(--gutter);
    top: 0;
    bottom: 86px;
    width: 3px;
    border-radius: 2px;
  }

  .rail-live {
    inset: 0;
    width: auto;
  }

  .rail-track {
    background: rgba(142, 180, 255, 0.09);
  }

  /*
   * The mask lives on the wrapper, and the glow is *painted*, not filtered.
   *
   * The glow was two `drop-shadow()` filters on this element. It looked right
   * and it was wrong: the filtered element is the full height of the section —
   * several thousand px on a phone — and `--cg` changes on it every animation
   * frame, so Safari re-rasterized a page-tall filter region per frame. That is
   * the whole of the reported stutter, and the ghosting too: iOS invalidates a
   * filtered layer in tiles, and the tiles the charge had already left kept
   * their old shadow. Scrolling back up therefore left glow behind while the
   * masked core underneath it correctly retreated.
   *
   * So there is no filter here at all. `.rail-bloom` is a wider sibling of the
   * core carrying two pre-blurred gradient bands — a tight bright one and a
   * broad dim one, standing in for the 5px and 16px shadows. Both children sit
   * under the wrapper's mask, so the glow still stops exactly where the charge
   * does, which was the reason the filter was on the parent in the first place.
   *
   * (The original note is still worth keeping: a `box-shadow` on the masked
   * element itself does not work, because a mask only paints within the
   * element's box and a shadow is drawn outside it.)
   */
  .rail-glow {
    mask-image: linear-gradient(
      180deg,
      #000 0,
      #000 var(--cg, 0%),
      transparent var(--cg, 0%)
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0,
      #000 var(--cg, 0%),
      transparent var(--cg, 0%)
    );
  }

  /*
   * Overflows the 3px rail on both sides. The mask above is a 180deg gradient,
   * so tiling it across this wider child yields identical values — the bloom is
   * cut off at the charge front just as the core is.
   */
  .rail-bloom {
    position: absolute;
    left: -19px;
    right: -19px;
    top: 0;
    bottom: 0;
    background:
      linear-gradient(90deg, transparent, oklch(0.8 0.17 200 / 0.7), transparent) 50% /
        13px 100% no-repeat,
      linear-gradient(90deg, transparent, oklch(0.8 0.17 200 / 0.32), transparent) 50% /
        38px 100% no-repeat;
  }

  /*
   * One gradient, one mask. Per-segment gradients kinked at every seam; a
   * single mask sliding down a single gradient physically cannot.
   */
  .rail-live {
    background: linear-gradient(180deg, var(--sodium), var(--cyan) 50%, var(--violet));
  }

  .rail-head {
    position: absolute;
    left: calc(var(--gutter) - 4px);
    top: 0;
    margin-top: -116px;
    width: 11px;
    height: 116px;
    border-radius: 6px;
    opacity: 0;
    pointer-events: none;
    filter: blur(3px);
    /*
     * A blurred element moved by transform every frame. Without the promotion
     * hint Safari re-rasterizes the blur against the page behind it on each
     * move, which is where the head's own smear trail came from.
     */
    will-change: transform;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(190, 225, 255, 0.4) 62%,
      rgba(255, 255, 255, 0.95)
    );
  }

  /*
   * The terminal mirrors `.tube-cap` at the other end of the run: the tube is
   * capped where the charge enters, and capped again where it lands. It sits
   * dark until the charge actually reaches it — `--lit` is set by fx.ts.
   */
  .rail-terminal {
    position: absolute;
    left: calc(var(--gutter) - 1.5px);
    bottom: 80px;
    width: 6px;
    height: 15px;
    border-radius: 1px;
    background: linear-gradient(180deg, #5d6272, #20242e);
    box-shadow: 0 0 calc(10px * var(--lit, 0))
      oklch(0.8 0.17 286 / calc(0.8 * var(--lit, 0)));
    transition:
      box-shadow 0.28s ease,
      filter 0.28s ease;
    filter: brightness(calc(1 + 0.6 * var(--lit, 0)));
  }

  .rows {
    padding-left: var(--rail-offset);
  }

  .row {
    position: relative;
    padding-bottom: 14px;
  }

  .node {
    position: absolute;
    left: -59px;
    top: 22px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    opacity: 0.12;
    background: var(--h);
    z-index: 1;
    /*
     * No transition on the driven properties.
     *
     * `nodeLit()` already kindles a node gradually — over a 40px ramp of charge
     * travel — so a CSS transition on top of it is a *second*, independent
     * smoothing with its own clock. At reading speed the two are
     * indistinguishable. On a fast flick, and especially when reversing
     * direction, the mask has no transition and snaps to the new charge while
     * the nodes ease toward it over 180ms, so the offshoots visibly trail the
     * line they are supposed to be lit by. The charge is the only clock.
     */
  }

  .offshoot {
    position: absolute;
    left: -50px;
    top: 26px;
    width: 51px;
    height: 1px;
    opacity: 0.15;
    background: linear-gradient(90deg, var(--h), transparent);
    /* Same reason as `.node` above: the ramp is the smoothing. */
  }

  /* Plates are <details> so they open with no JS at all. */
  /*
   * No padding on the plate itself. It used to carry `16px 18px 15px`, which
   * put a dead ring around the <summary> — clicking near the card's edge, or
   * anywhere in the tag row, did nothing. The padding now lives on the children
   * so the summary spans the entire collapsed card and all of it is clickable.
   */
  .plate {
    overflow: hidden;
  }

  .plate summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px 20px;
    align-items: baseline;
    cursor: pointer;
    list-style: none;
    padding: 16px 18px 15px;
  }

  .plate summary::-webkit-details-marker {
    display: none;
  }

  .plate-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }

  .plate-num {
    font: 400 10px var(--mono);
    letter-spacing: 0.14em;
    color: var(--h);
  }

  .plate-name {
    font: 700 26px var(--display);
    letter-spacing: -0.03em;
    color: #f2f6fd;
  }

  .plate-blurb {
    font: 400 11.5px var(--mono);
    color: var(--dim-2);
  }

  .plate-mark {
    font: 500 9px var(--mono);
    letter-spacing: 0.16em;
    color: var(--h);
    white-space: nowrap;
  }

  .plate-mark::after {
    content: 'OPEN +';
  }

  .plate[open] .plate-mark::after {
    content: 'COLLAPSE ×';
  }

  .plate-tags {
    grid-column: 1 / -1;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 4px;
  }

  /* The detail wipes down on the same plate — no modal, no navigation. */
  .plate-detail {
    margin: 0 18px 15px;
    padding-top: 14px;
    border-top: 1px solid rgba(142, 180, 255, 0.14);
    animation: plateIn 0.26s cubic-bezier(0.2, 0.85, 0.2, 1);
  }

  .plate-detail p {
    margin: 0;
    max-width: 680px;
    font: 400 12.5px/1.85 var(--mono);
    color: #b7c3d6;
  }

  .plate-links {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .rail-end {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 24px;
    font: 400 10px var(--mono);
    letter-spacing: 0.2em;
    color: var(--faint);
  }

  .rail-end-rule {
    width: 34px;
    height: 1px;
    background: oklch(0.8 0.17 286 / 0.6);
  }

  /* ----------------------------------------------------------- photographs */

  .tease {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    max-width: 900px;
  }

  .tease :global(.tile) {
    aspect-ratio: 4 / 5;
  }

  .tease :global(.tile img) {
    height: 100%;
    aspect-ratio: auto;
  }

  .tease-more {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(142, 180, 255, 0.2);
    background: rgba(8, 11, 19, 0.6);
    transition: all 0.22s;
  }

  .tease-more:hover {
