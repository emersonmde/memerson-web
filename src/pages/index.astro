---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoThumb from '../components/PhotoThumb.astro';
import { AUTHOR } from '../consts';
import { hueForIndex } from '../lib/ramp';
import { readingTime } from '../lib/readingTime';

/** Mockup 6a. See docs/UI-DESIGN.md §7. */

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);

const photos = (await getCollection('photos')).sort(
  (a, b) => (b.data.takenAt?.valueOf() ?? 0) - (a.data.takenAt?.valueOf() ?? 0),
);

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const PREVIEW_PHOTOS = 4;
const PREVIEW_POSTS = 3;

const teasePhotos = photos.slice(0, PREVIEW_PHOTOS);
const remainingPhotos = photos.length - teasePhotos.length;

const previewPosts = posts.slice(0, PREVIEW_POSTS);
const remainingPosts = posts.length - previewPosts.length;

// The mockup's "05 ALBUMS" has no data behind it; the year span does.
const years = photos
  .map((p) => p.data.takenAt?.getUTCFullYear())
  .filter(Boolean) as number[];
const yearSpan = years.length ? `${Math.min(...years)} — ${Math.max(...years)}` : '';
const bodies = new Set(photos.map((p) => p.data.camera).filter(Boolean)).size;

const pad = (n: number) => String(n).padStart(2, '0');
const railHue = (index: number) => hueForIndex(index, projects.length);

const projectLinks = (p: (typeof projects)[number]) =>
  [
    { label: 'SOURCE ↗', href: p.data.github },
    p.data.demo ? { label: 'DEMO ↗', href: p.data.demo } : null,
    p.data.docs ? { label: 'DOCS ↗', href: p.data.docs } : null,
    p.data.crate ? { label: 'CRATE ↗', href: p.data.crate } : null,
  ].filter(Boolean) as { label: string; href: string }[];

const photoMeta = (p: (typeof photos)[number]) =>
  [p.data.camera, p.data.aperture, p.data.shutter]
    .filter(Boolean)
    .join(' · ')
    .toUpperCase();

const isoDate = (d: Date | null) =>
  d ? d.toLocaleDateString('en-CA', { timeZone: 'UTC' }).replace(/-/g, '.') : '';
---

<BaseLayout
  title="Systems"
  description={`${AUTHOR.name} — ${AUTHOR.summary}. Systems programming, writing, and photography.`}
  active="systems"
  shooting={true}
>
  <section class="hero">
    <div class="hero-fx" aria-hidden="true">
      <div class="haze" data-fx="haze"></div>
      <div class="haze-2"></div>
      <div class="shaft" data-fx="shaft"></div>
      <div class="hero-floor"></div>
    </div>

    <div class="hero-body">
      <div class="kicker">MEMERSON.COM — DISTRICT 09 / PERSONAL</div>

      <div class="sign-wrap">
        <h1 class="sign">M.EMERSON</h1>
        <div class="sign-echo" aria-hidden="true">M.EMERSON</div>
      </div>

      <div class="tube-row">
        <div class="tube" aria-hidden="true">
          <span class="tube-elbow"></span>
          <span class="tube-bar"><span class="tube-spec"></span></span>
          <span class="tube-cap"></span>
        </div>
        <span class="tube-note">SCROLL ↓</span>
      </div>

      <div class="bio">
        <div class="bio-tube" aria-hidden="true"></div>
        <div class="bio-row">
          <p>
            {AUTHOR.name} — {AUTHOR.summary} at Amazon, leading engineers and applied scientists
            on LLM and agentic systems for hiring. {projects.length} systems below, written
            after hours, mostly in Rust.
          </p>
          <div class="bio-langs">RUST · C<br />JAVA · PYTHON<br />TYPESCRIPT</div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec-rail" data-rail-scope>
    <div class="sec-head">
      <span class="sec-num" style="--n:var(--sodium)">01</span>
      <span class="sec-rule"></span>
      <span class="sec-name">SYSTEMS</span>
      <a class="sec-aside" href="https://github.com/emersonmde">ALL REPOS ON GITHUB ↗</a>
    </div>

    <div class="rail-track" aria-hidden="true"></div>
    <div class="rail-live" data-fx="rail" aria-hidden="true"></div>
    <div class="rail-head" data-fx="head" aria-hidden="true"></div>

    <div class="rows">
      {
        projects.map((project, i) => (
          <div class="row" data-row style={`--h:${railHue(i)}`}>
            <span class="node" data-dot data-fx="node" aria-hidden="true" />
            <span class="offshoot" data-off aria-hidden="true" />

            <details class="plate">
              <span class="plate-charge" aria-hidden="true" />
              <span class="bracket bracket-tl" aria-hidden="true" />
              <span class="bracket bracket-tr" aria-hidden="true" />
              <span class="bracket bracket-bl" aria-hidden="true" />
              <span class="bracket bracket-br" aria-hidden="true" />

              <summary>
                <span class="plate-head">
                  <span class="plate-num">{pad(i + 1)}</span>
                  <span class="plate-name">{project.data.name}</span>
                  <span class="plate-blurb">{project.data.shortDescription}</span>
                </span>
                <span class="plate-mark" aria-hidden="true" />
              </summary>

              <div class="plate-tags">
                {project.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              <div class="plate-detail">
                <p>{project.data.description}</p>
                <div class="plate-links">
                  {projectLinks(project).map((link) => (
                    <a class="btn-ghost" href={link.href}>
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            </details>
          </div>
        ))
      }

      <div class="rail-end"><span class="rail-end-rule"></span>END OF LINE</div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <span class="sec-num" style="--n:var(--cyan)">02</span>
      <span class="sec-rule"></span>
      <span class="sec-name">PHOTOGRAPHS</span>
      <span class="sec-aside">{photos.length} FRAMES · {yearSpan}</span>
    </div>

    <a class="sec-title" data-fx="resolve" href="/photos">Photographs</a>

    <div class="sec-lede">
      <p>
        {photos.length} frames, {yearSpan}, across {bodies} cameras.
      </p>
      <a class="sec-aside" href="/photos">ALL {photos.length} FRAMES ↗</a>
    </div>

    <div class="tease">
      {
        teasePhotos.map((photo) => (
          <PhotoThumb
            photo={photo}
            sizes="170px"
            label={isoDate(photo.data.takenAt)}
            meta={photoMeta(photo)}
            href="/photos"
          />
        ))
      }
      <a class="tease-more" href="/photos">
        <span class="tease-more-n">+{remainingPhotos}</span>
        <span class="tease-more-l">CONTACT SHEET ↗</span>
      </a>
    </div>
  </section>

  <section class="sec">
    <div class="sec-head">
      <span class="sec-num" style="--n:var(--violet)">03</span>
      <span class="sec-rule"></span>
      <span class="sec-name">THE LOG</span>
      <a class="sec-aside" href="/rss.xml">{posts.length} POSTS · RSS ↗</a>
    </div>

    <a class="sec-title" data-fx="resolve" href="/blog">The log</a>

    <div class="sec-lede sec-lede-narrow">
      <p>Notes on things that broke, and what the profiler said afterwards.</p>
      <a class="sec-aside" href="/blog">ALL {posts.length} POSTS ↗</a>
    </div>

    <div class="log-preview">
      {
        previewPosts.map((post) => (
          <a class="log-row" href={`/blog/${post.id}`}>
            <span class="log-date">{isoDate(post.data.date)}</span>
            <span class="log-title">{post.data.title}</span>
            <span class="log-read">{readingTime(post.body)}</span>
          </a>
        ))
      }
      {
        remainingPosts > 0 && (
          <a class="log-all" href="/blog">
            <span>READ THE FULL LOG — {remainingPosts} MORE</span>
            <span class="log-all-arrow">↗</span>
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ------------------------------------------------------------------ hero */

  .hero {
    position: relative;
    padding: 112px var(--gutter) 0;
  }

  .hero-fx {
    position: absolute;
    left: 0;
    right: 0;
    top: -52px;
    height: 760px;
    overflow: hidden;
    pointer-events: none;
  }

  /* Nebula is hero-only: the one place it can be strong without fighting text. */
  .haze {
    position: absolute;
    inset: -25%;
    background: radial-gradient(
      closest-side at 24% 42%,
      oklch(0.55 0.2 288 / 0.42),
      transparent 68%
    );
    filter: blur(38px);
  }

  .haze-2 {
    position: absolute;
    inset: -25%;
    background: radial-gradient(
      closest-side at 78% 26%,
      oklch(0.8 0.18 200 / 0.2),
      transparent 66%
    );
    filter: blur(34px);
    animation: fogSlow 40s ease-in-out infinite;
  }

  .shaft {
    position: absolute;
    left: 27%;
    top: -18%;
    width: 18%;
    height: 118%;
    background: linear-gradient(180deg, oklch(0.8 0.18 200 / 0.12), transparent 74%);
    filter: blur(13px);
  }

  .hero-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    background: linear-gradient(180deg, transparent, var(--void));
  }

  .hero-body {
    position: relative;
  }

  .kicker {
    font: 500 10px var(--mono);
    letter-spacing: 0.3em;
    color: var(--faint);
    margin-bottom: 22px;
  }

  /*
   * Sized to the word rather than a fixed measure. The mockup hard-coded 600px
   * to fit "EMERSON"; "M.EMERSON" overruns that, and a literal width would have
   * to be re-guessed every time the wordmark changes.
   */
  .sign-wrap {
    position: relative;
    width: fit-content;
  }

  .sign {
    margin: 0;
    font: 700 116px/0.9 var(--display);
    letter-spacing: -0.055em;
    color: var(--tx-hi);
    text-shadow:
      -1.5px 0 0 oklch(0.68 0.26 348 / 0.3),
      1.5px 0 0 oklch(0.8 0.18 200 / 0.36),
      0 0 16px oklch(0.8 0.18 200 / 0.5),
      0 0 70px oklch(0.8 0.18 200 / 0.36);
    animation: neonFlicker 15s steps(1, end) infinite;
  }

  /* Wet-floor echo. */
  .sign-echo {
    font: 700 116px/0.9 var(--display);
    letter-spacing: -0.055em;
    color: var(--tx-hi);
    text-shadow: 0 0 16px oklch(0.8 0.18 200 / 0.8);
    transform: scaleY(-1);
    opacity: 0.13;
    filter: blur(2.6px);
    mask-image: linear-gradient(transparent 46%, #000);
    -webkit-mask-image: linear-gradient(transparent 46%, #000);
    height: 74px;
    overflow: hidden;
  }

  .tube-row {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-top: 16px;
    height: 18px;
  }

  .tube {
    position: relative;
    flex: none;
    width: 518px;
    height: 18px;
  }

  .tube-elbow {
    position: absolute;
    left: 0;
    top: 0;
    width: 18px;
    height: 18px;
    border-top: 3px solid var(--sodium);
    border-left: 3px solid var(--sodium);
    border-top-left-radius: 18px;
    filter: drop-shadow(0 0 6px var(--sodium))
      drop-shadow(0 0 20px oklch(0.82 0.17 66 / 0.6));
  }

  .tube-bar {
    position: absolute;
    left: 18px;
    right: 12px;
    top: 0;
    height: 3px;
    border-radius: 2px;
    background: var(--sodium);
    box-shadow:
      0 0 9px var(--sodium),
      0 0 34px oklch(0.82 0.17 66 / 0.55);
    overflow: hidden;
  }

  /* Energy travels; the tube itself holds still. */
  .tube-spec {
    position: absolute;
    inset: -2px;
    background: linear-gradient(90deg, transparent, #fff7e6, transparent);
    background-size: 30% 100%;
    background-repeat: no-repeat;
    filter: blur(1.5px);
    animation: travel 6.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  .tube-cap {
    position: absolute;
    right: 0;
    top: -6px;
    width: 6px;
    height: 15px;
    border-radius: 1px;
    background: linear-gradient(180deg, #5d6272, #20242e);
    box-shadow: 0 0 10px oklch(0.82 0.17 66 / 0.5);
  }

  .tube-note {
    font: 400 9.5px/1.5 var(--mono);
    letter-spacing: 0.2em;
    color: var(--faint);
    white-space: nowrap;
  }

  .bio {
    position: relative;
    padding: 34px 0 66px var(--rail-offset);
  }

  .bio-tube {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 2px;
    background: var(--sodium);
    box-shadow:
      0 0 9px oklch(0.82 0.17 66 / 0.75),
      0 0 30px oklch(0.82 0.17 66 / 0.35);
  }

  .bio-row {
    display: flex;
    align-items: flex-end;
    gap: 34px;
  }

  .bio-row p {
    margin: 0;
    max-width: 540px;
    font: 400 14px/1.8 var(--mono);
    color: #94a2b8;
    text-wrap: pretty;
  }

  .bio-langs {
    font: 400 10px/1.9 var(--mono);
    letter-spacing: 0.14em;
    color: var(--faint);
    border-left: 1px solid rgba(142, 180, 255, 0.16);
    padding-left: 16px;
  }

  /* --------------------------------------------------------------- systems */

  .sec-rail {
    padding-bottom: 86px;
  }

  .rail-track,
  .rail-live {
    position: absolute;
    left: var(--gutter);
    top: 52px;
    bottom: 86px;
    width: 3px;
    border-radius: 2px;
  }

  .rail-track {
    background: rgba(142, 180, 255, 0.09);
  }

  /*
   * One gradient, one mask. Per-segment gradients kinked at every seam; a
   * single mask sliding down a single gradient physically cannot.
   */
  .rail-live {
    background: linear-gradient(180deg, var(--sodium), var(--cyan) 50%, var(--violet));
    box-shadow: 0 0 9px -1px oklch(0.8 0.17 200 / 0.55);
    mask-image: linear-gradient(
      180deg,
      #000 0,
      #000 var(--cg, 0%),
      transparent var(--cg, 0%)
    );
    -webkit-mask-image: linear-gradient(
      180deg,
      #000 0,
      #000 var(--cg, 0%),
      transparent var(--cg, 0%)
    );
  }

  .rail-head {
    position: absolute;
    left: calc(var(--gutter) - 4px);
    top: 52px;
    margin-top: -116px;
    width: 11px;
    height: 116px;
    border-radius: 6px;
    opacity: 0;
    pointer-events: none;
    filter: blur(3px);
    background: linear-gradient(
      180deg,
      transparent,
      rgba(190, 225, 255, 0.4) 62%,
      rgba(255, 255, 255, 0.95)
    );
  }

  .rows {
    padding-left: var(--rail-offset);
  }

  .row {
    position: relative;
    padding-bottom: 14px;
  }

  .node {
    position: absolute;
    left: -59px;
    top: 22px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    opacity: 0.12;
    background: var(--h);
    box-shadow: 0 0 14px var(--h);
    z-index: 1;
  }

  .offshoot {
    position: absolute;
    left: -50px;
    top: 26px;
    width: 51px;
    height: 1px;
    background: linear-gradient(90deg, var(--h), transparent);
  }

  /* Plates are <details> so they open with no JS at all. */
  .plate {
    padding: 16px 18px 15px;
    overflow: hidden;
  }

  .plate summary {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 20px;
    align-items: baseline;
    cursor: pointer;
    list-style: none;
  }

  .plate summary::-webkit-details-marker {
    display: none;
  }

  .plate-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }

  .plate-num {
    font: 400 10px var(--mono);
    letter-spacing: 0.14em;
    color: var(--h);
  }

  .plate-name {
    font: 700 26px var(--display);
    letter-spacing: -0.03em;
    color: #f2f6fd;
  }

  .plate-blurb {
    font: 400 11.5px var(--mono);
    color: var(--dim-2);
  }

  .plate-mark {
    font: 500 9px var(--mono);
    letter-spacing: 0.16em;
    color: var(--h);
    white-space: nowrap;
  }

  .plate-mark::after {
    content: 'OPEN +';
  }

  .plate[open] .plate-mark::after {
    content: 'COLLAPSE ×';
  }

  .plate-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 12px;
  }

  /* The detail wipes down on the same plate — no modal, no navigation. */
  .plate-detail {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid rgba(142, 180, 255, 0.14);
    animation: plateIn 0.26s cubic-bezier(0.2, 0.85, 0.2, 1);
  }

  .plate-detail p {
    margin: 0;
    max-width: 680px;
    font: 400 12.5px/1.85 var(--mono);
    color: #b7c3d6;
  }

  .plate-links {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
  }

  .rail-end {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 24px;
    font: 400 10px var(--mono);
    letter-spacing: 0.2em;
    color: var(--faint);
  }

  .rail-end-rule {
    width: 34px;
    height: 1px;
    background: oklch(0.8 0.17 286 / 0.6);
  }

  /* ----------------------------------------------------------- photographs */

  .tease {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    max-width: 900px;
  }

  .tease :global(.tile) {
    aspect-ratio: 4 / 5;
  }

  .tease :global(.tile img) {
    height: 100%;
    aspect-ratio: auto;
  }

  .tease-more {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(142, 180, 255, 0.2);
    background: rgba(8, 11, 19, 0.6);
    transition: all 0.22s;
  }

  .tease-more:hover {
    border-color: var(--cyan);
    box-shadow: 0 0 44px -18px var(--cyan);
    transform: translateY(-3px);
  }

  .tease-more-n {
    font: 700 24px var(--display);
    letter-spacing: -0.03em;
    color: var(--tx);
  }

  .tease-more-l {
    font: 400 8.5px var(--mono);
    letter-spacing: 0.18em;
    color: var(--dim);
  }

  /* ------------------------------------------------------------------- log */

  .sec-lede-narrow {
    max-width: 760px;
    margin-bottom: 6px;
  }

  .log-preview {
    display: flex;
    flex-direction: column;
    max-width: 760px;
    margin-top: 12px;
  }

  .log-row {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    gap: 24px;
    align-items: baseline;
    padding: 18px 0;
    border-top: 1px solid rgba(142, 180, 255, 0.1);
    transition: background 0.16s;
  }

  .log-row:hover {
    background: rgba(142, 180, 255, 0.03);
  }

  .log-date,
  .log-read {
    font: 400 9.5px var(--mono);
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  /* Serif here because the row is a piece of the log, not the index. */
  .log-title {
    font: 300 21px/1.35 var(--serif);
    color: #cdd6e5;
  }

  .log-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    border-top: 1px solid rgba(142, 180, 255, 0.1);
    border-bottom: 1px solid rgba(142, 180, 255, 0.1);
    font: 500 10px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
    transition:
      color 0.16s,
      background 0.16s;
  }

  .log-all:hover {
    color: var(--cyan);
    background: rgba(142, 180, 255, 0.03);
  }

  .log-all-arrow {
    font-size: 13px;
  }
</style>
