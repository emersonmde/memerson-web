---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, SOCIAL } from '../consts';

const photoCount = (await getCollection('photos')).length;

/**
 * Not in the mockup — extended from the design language. See UI-DESIGN §7.
 *
 * The choice made here: About is a *reading* page, so it takes the log's serif
 * measure rather than the index's mono. The skills block stays mono because it
 * is metadata, which is exactly the split §3 describes.
 */
const SKILLS = [
  { label: 'LANGUAGES', value: 'Rust, Java, Python, C, TypeScript' },
  { label: 'SYSTEMS', value: 'AWS, DynamoDB, PostgreSQL, Linux' },
  {
    label: 'INTERESTS',
    value:
      'Distributed systems, storage engines, protocols, algorithms, operating systems, emulators',
  },
];

const LINKS = [
  { label: 'GITHUB', value: 'github.com/emersonmde', href: SOCIAL.github },
  { label: 'LINKEDIN', value: 'linkedin.com/in/emersonmde', href: SOCIAL.linkedin },
  { label: 'PHOTOS', value: `${photoCount} frames`, href: '/photos' },
  { label: 'RSS', value: '/rss.xml', href: '/rss.xml' },
];
---

<BaseLayout
  title="About"
  description={`About ${AUTHOR.name}, ${AUTHOR.summary} at Amazon.`}
  active="about"
  back={true}
>
  <article class="about">
    <div class="page-haze" aria-hidden="true"></div>
    <nav class="about-crumb" aria-label="Breadcrumb">
      <a href="/">/</a>
      <span aria-current="page">ABOUT</span>
    </nav>

    <h1 class="about-h1 neon-h" data-fx="resolve">Matthew Emerson</h1>

    <div class="about-prose">
      <p>
        I'm {AUTHOR.name}, a {AUTHOR.summary} at Amazon.
      </p>
      <p>
        I lead a cross-functional team of software engineers and applied scientists
        building AI/ML features for talent acquisition. We focus on rapid experimentation
        with LLMs and agentic systems to transform hiring workflows at scale.
      </p>
      <p>
        Outside of work, I'm drawn to systems programming and understanding how things
        work at a fundamental level. I spend my free time building databases, consensus
        protocols, emulators, and other low-level systems.
      </p>
    </div>

    <section class="about-block" aria-labelledby="skills">
      <h2 class="about-h2" id="skills">01 — SKILLS</h2>
      <dl class="rows-dl">
        {
          SKILLS.map((skill) => (
            <div class="rows-row">
              <dt>{skill.label}</dt>
              <dd>{skill.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="about-block" aria-labelledby="links">
      <h2 class="about-h2" id="links">02 — ELSEWHERE</h2>
      <div class="links">
        {
          LINKS.map((link) => (
            <a class="link-row" href={link.href}>
              <span class="link-label">{link.label}</span>
              <span class="link-arrow">→</span>
              <span class="link-value">{link.value}</span>
            </a>
          ))
        }
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .about {
    position: relative;
    padding: 92px var(--gutter) 70px;
    /* The person page sits in warm light: sodium leads, cyan seconds. */
    --haze-a: oklch(0.55 0.14 66 / 0.2);
    --haze-b: oklch(0.58 0.13 205 / 0.12);
  }

  .about-crumb {
    display: flex;
    gap: 8px;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.24em;
    margin-bottom: 18px;
  }

  .about-crumb a {
    color: var(--cyan);
    transition: color 0.16s;
  }

  .about-crumb a:hover {
    color: var(--sodium);
  }

  .about-crumb [aria-current] {
    color: var(--dim);
  }

  .about-h1 {
    margin: 0 0 28px;
    font: 700 54px/1.05 var(--display);
    letter-spacing: -0.045em;
    color: var(--tx-hi);
  }

  .about-prose {
    max-width: 62ch;
    font: 300 19px/1.68 var(--serif);
    color: var(--tx-read);
  }

  .about-prose p {
    margin: 0 0 20px;
  }

  .about-prose p:first-child {
    font-weight: 400;
    color: var(--tx-body);
  }

  .about-block {
    margin-top: 48px;
    max-width: 760px;
  }

  .about-h2 {
    margin: 0 0 16px;
    font: 500 9.5px var(--mono);
    letter-spacing: 0.24em;
    color: var(--faint);
  }

  /* The section marker's tick, lit in the room's own sodium. Long enough to
     underline the first word or two — a fixed length, deliberately not tied
     to the text, so a long heading cannot stretch it into a bar. */
  .about-h2::after {
    content: '';
    display: block;
    margin-top: 8px;
    width: 150px;
    height: 2px;
    background: linear-gradient(90deg, var(--sodium), transparent);
    box-shadow: 0 0 12px oklch(0.82 0.17 66 / 0.6);
  }

  .rows-dl {
    margin: 0;
  }

  .rows-row {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 20px;
    padding: 12px 0;
    border-top: 1px solid rgba(142, 180, 255, 0.1);
  }

  .rows-row dt {
    font: 400 9.5px var(--mono);
    letter-spacing: 0.16em;
    color: var(--faint);
    padding-top: 4px;
  }

  .rows-row dd {
    margin: 0;
    font: 400 13px/1.7 var(--mono);
    color: var(--tx-read);
  }

  .links {
    display: flex;
    flex-direction: column;
  }

  .link-row {
    display: grid;
    grid-template-columns: 130px 20px 1fr;
    gap: 20px;
    align-items: baseline;
    padding: 12px 0;
    border-top: 1px solid rgba(142, 180, 255, 0.1);
    transition: background 0.16s;
  }

  .link-row:hover {
    background: rgba(142, 180, 255, 0.03);
  }

  .link-label {
    font: 400 9.5px var(--mono);
    letter-spacing: 0.16em;
    color: var(--faint);
  }

  .link-arrow {
    color: var(--faint-2);
    font: 400 11px var(--mono);
  }

  .link-value {
    font: 400 13px var(--mono);
    color: var(--cyan);
    transition: color 0.16s;
  }

  .link-row:hover .link-value {
    color: var(--sodium);
  }

  /* --------------------------------------------------------- small screens */

  @media (max-width: 720px) {
    .about {
      padding: 76px var(--gutter) 56px;
    }

    .about-h1 {
      font-size: clamp(34px, 8.8vw, 54px);
      margin-bottom: 20px;
    }

    .about-block {
      margin-top: 36px;
    }

    /*
     * At phone width the 130px label column eats a third of the line for four
     * characters of mono, so both row types stack: label above value, and the
     * link arrow pinned right across both lines.
     */
    .rows-row {
      grid-template-columns: 1fr;
      gap: 3px;
      padding: 14px 0;
    }

    .rows-row dt {
      padding-top: 0;
    }

    .link-row {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 3px 12px;
      padding: 14px 0;
      min-height: 56px;
    }

    .link-label {
      grid-column: 1;
    }

    .link-arrow {
      grid-row: 1 / 3;
      grid-column: 2;
      font-size: 15px;
    }

    .link-value {
      grid-column: 1;
      font-size: 14px;
    }
  }

  @media (max-width: 560px) {
    .about-prose {
      font-size: 17.5px;
      line-height: 1.62;
    }
  }

  @media (hover: none) {
    .link-row {
      min-height: 56px;
    }
  }
</style>
