---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { readingTime } from '../../lib/readingTime';

/**
 * Mockup 6c — the log index. The neon drops away here and serif takes over;
 * the year pins as you pass it. See docs/UI-DESIGN.md §7.
 */
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Grouped by year, newest first, preserving the sort within each group.
const byYear = new Map<number, CollectionEntry<'blog'>[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

const monthDay = (d: Date) =>
  d
    .toLocaleDateString('en-CA', { timeZone: 'UTC', month: '2-digit', day: '2-digit' })
    .replace('-', '.');
---

<BaseLayout
  title="The log"
  description="Writing on systems programming, storage engines, and things that broke."
  active="log"
  back={true}
>
  <section class="log">
    <div class="page-haze" aria-hidden="true"></div>
    <h1 class="log-h1 neon-h" data-fx="resolve">The log</h1>

    <div class="log-intro">
      <p>
        {posts.length} posts. Postmortems on my own code, mostly — the profiler is usually the
        antagonist.
      </p>
      <a class="log-rss" href="/rss.xml">RSS ↗</a>
    </div>

    {
      posts.length === 0 ? (
        <p class="log-empty">Nothing here yet.</p>
      ) : (
        years.map(([year, entries]) => (
          <div class="year">
            <div>
              <div class="year-num">{year}</div>
            </div>
            <div class="year-posts">
              {entries.map((post) => (
                <a class="entry" href={`/blog/${post.id}`}>
                  <div class="entry-top">
                    <span class="entry-title">{post.data.title}</span>
                    <span class="entry-when">
                      {monthDay(post.data.date)} · {readingTime(post.body)}
                    </span>
                  </div>
                  <p class="entry-dek">{post.data.description}</p>
                </a>
              ))}
            </div>
          </div>
        ))
      )
    }
  </section>
</BaseLayout>

<style>
  .log {
    position: relative;
    padding: 94px var(--gutter) 60px;
    max-width: 940px;
  }

  .log-h1 {
    margin: 0;
    font: 700 58px/1 var(--display);
    letter-spacing: -0.05em;
    color: var(--tx-hi);
  }

  .log-intro {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-top: 14px;
    padding-bottom: 26px;
  }

  .log-intro p {
    margin: 0;
    max-width: 460px;
    font: 400 12px/1.8 var(--mono);
    color: var(--dim);
  }

  .log-rss {
    font: 400 9.5px var(--mono);
    letter-spacing: 0.18em;
    color: var(--faint);
    white-space: nowrap;
    transition: color 0.16s;
  }

  .log-rss:hover {
    color: var(--cyan);
  }

  .log-empty {
    font: 400 12px/1.8 var(--mono);
    color: var(--dim);
  }

  .year {
    position: relative;
    display: grid;
    grid-template-columns: 78px 1fr;
    gap: 22px;
    padding-top: 8px;
  }

  /*
   * Pins while its run passes, then hands off — the only chrome the log gets.
   * Lit like a district sign: violet is the archive's light, and the glow is
   * what lets a 22%-alpha numeral read as neon rather than as disabled text.
   */
  .year-num {
    position: sticky;
    top: calc(var(--nav-h) + 18px);
    font: 700 30px var(--display);
    letter-spacing: -0.04em;
    color: oklch(0.8 0.17 286 / 0.45);
    text-shadow: 0 0 22px oklch(0.8 0.17 286 / 0.4);
  }

  .year-posts {
    display: flex;
    flex-direction: column;
  }

  .entry {
    position: relative;
    display: block;
    padding: 20px 0;
    border-top: 1px solid rgba(142, 180, 255, 0.1);
    transition: background 0.16s;
  }

  /* The separator's lit segment — the about page's tick technique, in the
     archive's violet. Fixed length; the hairline carries the rest. */
  .entry::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 96px;
    height: 1px;
    background: linear-gradient(90deg, oklch(0.8 0.17 286 / 0.75), transparent);
    box-shadow: 0 0 10px oklch(0.8 0.17 286 / 0.45);
  }

  .entry:hover {
    background: rgba(142, 180, 255, 0.03);
  }

  /* A touchable thing lights up when reached for — cyan, like every control. */
  .entry:hover .entry-title {
    color: var(--tx-hi);
    text-shadow: 0 0 18px oklch(0.8 0.17 200 / 0.45);
  }

  .entry-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
  }

  .entry-title {
    font: 400 22px/1.3 var(--serif);
    color: #dde5f2;
    max-width: 520px;
    transition:
      color 0.16s,
      text-shadow 0.16s;
  }

  .entry-when {
    font: 400 9px var(--mono);
    letter-spacing: 0.14em;
    color: var(--faint);
    white-space: nowrap;
  }

  .entry-dek {
    margin: 8px 0 0;
    max-width: 560px;
    font: 300 15px/1.6 var(--serif);
    color: #8c98ab;
  }

  /* --------------------------------------------------------- small screens */

  @media (max-width: 720px) {
    .log-h1 {
      font-size: clamp(38px, 10vw, 58px);
    }

    .log-intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      padding-bottom: 20px;
    }

    .log-intro p {
      max-width: none;
    }

    /*
     * The sticky 78px year column eats a fifth of the line for four digits, so
     * the year becomes a marker above its group instead of a rail beside it.
     * Same hierarchy, none of the horizontal cost — and it still pins.
     */
    .year {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .year-num {
      position: static;
      margin-bottom: 2px;
      font-size: 22px;
      color: rgba(142, 180, 255, 0.35);
    }

    .entry {
      padding: 16px 0;
    }

    .entry-top {
      flex-wrap: wrap;
      gap: 4px 14px;
    }

    .entry-title {
      font-size: 19px;
      max-width: none;
    }

    .entry-dek {
      margin-top: 6px;
      font-size: 14px;
      max-width: none;
    }
  }

  @media (hover: none) {
    .entry {
      min-height: 56px;
    }
  }
</style>
