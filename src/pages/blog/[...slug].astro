---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR } from '../../consts';
import { readingTime } from '../../lib/readingTime';

/**
 * Mockup 6d — the post. 68ch serif measure, one lit edge on code, and the rail
 * reduced to a reading-progress hairline. See docs/UI-DESIGN.md §7.
 */
export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  // Prev/next are computed here so each page gets its neighbours as props
  // rather than re-reading the whole collection per route.
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // The list is newest-first, so the *next* index is the older post.
      newer: i > 0 ? posts[i - 1] : undefined,
      older: i < posts.length - 1 ? posts[i + 1] : undefined,
    },
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
};

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

const stamp = post.data.date
  .toLocaleDateString('en-CA', { timeZone: 'UTC' })
  .replace(/-/g, '.');
const minutes = readingTime(post.body);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  active="log"
  back={true}
>
  <div class="progress" data-fx="progress" aria-hidden="true"></div>

  <article class="post">
    <div class="page-haze" aria-hidden="true"></div>
    <nav class="post-crumb" aria-label="Breadcrumb">
      <a href="/">/</a>
      <a href="/blog">LOG</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{post.id.toUpperCase()}</span>
    </nav>

    <h1 class="post-h1 neon-h" data-fx="resolve">{post.data.title}</h1>

    <div class="post-meta">
      <span>{AUTHOR.name.toUpperCase()}</span>
      <span>{stamp}</span>
      <span>{minutes}</span>
    </div>

    <div class="prose">
      <Content />
    </div>

    {
      (newer || older) && (
        <nav class="post-nav" aria-label="More posts">
          {older ? (
            <a class="post-nav-item" href={`/blog/${older.id}`} rel="prev">
              <div class="post-nav-dir">← PREVIOUS</div>
              <div class="post-nav-title">{older.data.title}</div>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a class="post-nav-item post-nav-next" href={`/blog/${newer.id}`} rel="next">
              <div class="post-nav-dir">NEXT →</div>
              <div class="post-nav-title">{newer.data.title}</div>
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  /* The rail, reduced to a hairline. Sits directly under the nav. */
  .progress {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    height: 2px;
    width: 0;
    z-index: 10;
    background: linear-gradient(90deg, oklch(0.82 0.17 66 / 0.25), var(--sodium));
    box-shadow: 0 0 10px var(--sodium);
  }

  /*
   * The charge's head, carried over from the home rail: sodium means "where
   * you are" everywhere on the site, and on a post that is how far you have
   * read. The head breathes; the bar does not move unless you do.
   */
  .progress::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    transform: translate(50%, -50%);
    background: #fff;
    box-shadow:
      0 0 8px 2px var(--sodium),
      0 0 22px 6px oklch(0.82 0.17 66 / 0.5);
    animation: headBreathe 2.8s ease-in-out infinite;
  }

  @keyframes headBreathe {
    50% {
      box-shadow:
        0 0 10px 3px var(--sodium),
        0 0 32px 10px oklch(0.82 0.17 66 / 0.6);
    }
  }

  .post {
    position: relative;
    padding: 92px var(--gutter) 70px;
    /* The reading room is keyed cyan; violet steps back to the second light. */
    --haze-a: oklch(0.55 0.13 205 / 0.24);
    --haze-b: oklch(0.42 0.16 296 / 0.22);
  }

  .post-crumb {
    display: flex;
    gap: 8px;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.24em;
    color: var(--faint);
    margin-bottom: 18px;
  }

  .post-crumb a {
    color: var(--cyan);
    transition: color 0.16s;
  }

  .post-crumb a:hover {
    color: var(--sodium);
  }

  .post-crumb [aria-current] {
    color: var(--dim);
  }

  .post-h1 {
    margin: 0;
    max-width: 640px;
    font: 700 44px/1.08 var(--display);
    letter-spacing: -0.04em;
    color: var(--tx-hi);
  }

  .post-meta {
    display: flex;
    gap: 22px;
    margin: 22px 0 34px;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.16em;
    color: var(--faint);
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    max-width: 640px;
    margin-top: 46px;
    padding-top: 22px;
    border-top: 1px solid rgba(142, 180, 255, 0.1);
  }

  .post-nav-item {
    max-width: 240px;
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav-dir {
    font: 400 9px var(--mono);
    letter-spacing: 0.18em;
    color: var(--faint);
    margin-bottom: 6px;
  }

  .post-nav-title {
    font: 300 16px/1.4 var(--serif);
    color: var(--tx-read);
    transition: color 0.16s;
  }

  .post-nav-item:hover .post-nav-title {
    color: var(--tx);
  }

  /* --------------------------------------------------------- small screens */

  @media (max-width: 720px) {
    .post {
      padding: 76px var(--gutter) 56px;
    }

    .post-crumb {
      flex-wrap: wrap;
      gap: 6px;
      font-size: 8.5px;
      letter-spacing: 0.2em;
    }

    .post-h1 {
      font-size: clamp(28px, 7.8vw, 44px);
      max-width: none;
    }

    .post-meta {
      flex-wrap: wrap;
      gap: 12px 16px;
      margin: 16px 0 26px;
      font-size: 9px;
    }

    .post-nav {
      flex-direction: column;
      gap: 20px;
      margin-top: 36px;
    }

    .post-nav-item {
      max-width: none;
    }

    .post-nav-next {
      text-align: left;
    }
  }
</style>

<style is:global>
  /* ---------------------------------------------------------------------
   * Prose. Global rather than scoped because this styles markdown Astro
   * renders inside <Content />, which never receives the scope attribute.
   *
   * This is the one place the neon drops away entirely: serif, 68ch, hairline
   * rules. See docs/UI-DESIGN.md §3.
   * ------------------------------------------------------------------- */

  .prose {
    max-width: 68ch;
    font: 300 19px/1.68 var(--serif);
    color: var(--tx-read);
  }

  .prose > * {
    margin: 0 0 22px;
  }

  /* The opening paragraph carries a touch more weight and light. */
  .prose > p:first-of-type {
    font-weight: 400;
    color: var(--tx-body);
  }

  .prose h2,
  .prose h3,
  .prose h4,
  .prose h5 {
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--tx-hi);
    margin: 44px 0 14px;
    line-height: 1.15;
  }

  /*
   * One level lower than the raw tag suggests: astro.config.mjs demotes every
   * heading inside a post so the page keeps a single h1. An authored `#` lands
   * here as h2 and should still look like a top-level section head.
   */
  .prose h2 {
    font-size: 30px;
  }

  /*
   * A section head carries a lit tick — the one place light enters the
   * reading column, and it marks structure, not prose. Cyan, because a
   * heading is a handle: it is what the eye grabs to navigate.
   */
  .prose h2::after {
    content: '';
    display: block;
    margin-top: 10px;
    width: 34px;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan), transparent);
    box-shadow: 0 0 12px oklch(0.8 0.17 200 / 0.7);
  }
  .prose h3 {
    font-size: 24px;
  }
  .prose h4 {
    font-size: 20px;
  }
  .prose h5 {
    font-size: 17px;
  }

  .prose a {
    color: var(--cyan);
    text-decoration: underline;
    text-decoration-color: oklch(0.8 0.17 200 / 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.16s;
  }

  .prose a:hover {
    text-decoration-color: var(--cyan);
    text-shadow: 0 0 14px oklch(0.8 0.17 200 / 0.55);
  }

  .prose strong {
    color: var(--tx);
    font-weight: 500;
  }

  .prose em {
    font-style: italic;
  }

  .prose ul,
  .prose ol {
    padding-left: 22px;
  }

  .prose li {
    margin-bottom: 8px;
  }

  .prose li::marker {
    color: var(--faint);
  }

  /* Inline code steps out of the serif and into the mono voice. */
  .prose :not(pre) > code {
    font: 400 15px var(--mono);
    color: var(--tx);
    background: rgba(142, 180, 255, 0.08);
    padding: 1px 5px;
  }

  /* One lit edge, and only one. */
  .prose pre {
    position: relative;
    padding: 18px 20px;
    background: rgba(8, 11, 19, 0.9);
    border-left: 2px solid var(--cyan);
    box-shadow: -8px 0 30px -18px var(--cyan);
    overflow-x: auto;
    font: 400 12.5px/1.85 var(--mono);
  }

  .prose pre code {
    font: inherit;
    background: none;
    padding: 0;
    color: #b7c3d6;
  }

  /* Another voice, another light: quotes take the violet edge the way code
     takes the cyan one. Same "one lit edge" rule, different speaker. */
  .prose blockquote {
    padding: 0 0 0 22px;
    border-left: 2px solid var(--violet);
    box-shadow: -8px 0 30px -18px var(--violet);
    font: 300 italic 21px/1.6 var(--serif);
    color: #dde5f2;
  }

  .prose blockquote p {
    margin: 0;
  }

  /* A scene break is a thin lit line across the dark, not a pencil rule. */
  .prose hr {
    border: 0;
    height: 1px;
    margin: 40px 0;
    background: linear-gradient(
      90deg,
      transparent,
      oklch(0.8 0.17 286 / 0.45),
      transparent
    );
    box-shadow: 0 0 14px oklch(0.8 0.17 286 / 0.3);
  }

  /* Colocated screenshots and diagrams, via astro:assets. */
  .prose img {
    width: 100%;
    height: auto;
    border: 1px solid var(--hairline);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font: 400 13px/1.7 var(--mono);
    color: var(--tx-read);
  }

  .prose th,
  .prose td {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 1px solid rgba(142, 180, 255, 0.12);
  }

  .prose th {
    color: var(--dim);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 10px;
  }

  /* ---------------------------------------------------------------------
   * The post is the one page where a phone is genuinely the better device,
   * so it gets the most care.
   * ------------------------------------------------------------------- */

  @media (max-width: 900px) {
    .prose {
      font-size: 18px;
    }
  }

  @media (max-width: 560px) {
    /*
     * 17.5 / 1.62 puts the measure at roughly 38 characters, which is where
     * phone reading wants to be.
     */
    .prose {
      font-size: 17.5px;
      line-height: 1.62;
    }

    .prose > * {
      margin-bottom: 19px;
    }

    .prose h2 {
      font-size: 23px;
    }

    .prose h3 {
      font-size: 20px;
    }

    .prose h4 {
      font-size: 17.5px;
    }

    /*
     * Code breaks out of the gutter and runs edge to edge, keeping its cyan
     * rule pinned to the screen edge. Long lines are the one thing a narrow
     * column genuinely cannot serve, so they get every pixel.
     */
    .prose pre {
      margin-left: calc(var(--gutter) * -1);
      margin-right: calc(var(--gutter) * -1);
      padding: 14px var(--gutter);
      font-size: 11.5px;
      line-height: 1.8;
      box-shadow: none;
    }

    .prose blockquote {
      padding-left: 16px;
      font-size: 19px;
    }

    .prose :not(pre) > code {
      font-size: 13.5px;
    }

    .prose table {
      font-size: 11px;
    }

    .prose th,
    .prose td {
      padding: 7px 8px;
    }
  }
</style>
