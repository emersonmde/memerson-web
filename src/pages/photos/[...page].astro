---
import { getCollection } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoThumb from '../../components/PhotoThumb.astro';
import { PHOTOS_PAGE_SIZE } from '../../consts';

/**
 * Mockup 6b — the contact sheet. See docs/UI-DESIGN.md §7.
 *
 * Paginated static pages: initial HTML never carries metadata for photos it
 * isn't showing. See docs/ARCHITECTURE.md §6.
 */
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const photos = (await getCollection('photos')).sort((a, b) => {
    const at = a.data.takenAt?.valueOf() ?? 0;
    const bt = b.data.takenAt?.valueOf() ?? 0;
    return bt - at;
  });

  // paginate([]) emits no routes at all, which would leave /photos missing while
  // the manifest is empty. Emit an explicit empty first page instead.
  if (photos.length === 0) {
    return [{ params: { page: undefined }, props: { photos: [], total: 0 } }];
  }

  return paginate(photos, {
    pageSize: PHOTOS_PAGE_SIZE,
    props: { total: photos.length },
  });
};

interface Props {
  page?: Page<CollectionEntry<'photos'>>;
  photos?: CollectionEntry<'photos'>[];
  total: number;
}

/*
 * Cast rather than rely on inference: getStaticPaths has two return shapes here
 * (the empty-manifest guard and the paginate call), so Astro widens the inferred
 * props to {} and every access below fails to type-check.
 */
const { page, photos, total } = Astro.props as unknown as Props;
const items = page?.data ?? photos ?? [];

const all = await getCollection('photos');
const years = all
  .map((p) => p.data.takenAt?.getUTCFullYear())
  .filter(Boolean) as number[];
const yearSpan = years.length ? `${Math.min(...years)} — ${Math.max(...years)}` : '';
const distinctYears = new Set(years).size;

// One column's worth of width at the sheet's four columns.
const SIZES = '(max-width: 900px) 45vw, 260px';

const meta = (p: CollectionEntry<'photos'>) =>
  [
    p.data.camera,
    p.data.aperture,
    p.data.shutter,
    p.data.iso ? `ISO ${p.data.iso}` : null,
  ]
    .filter(Boolean)
    .join(' · ')
    .toUpperCase();

const label = (p: CollectionEntry<'photos'>) =>
  p.data.takenAt
    ? p.data.takenAt.toLocaleDateString('en-CA', { timeZone: 'UTC' }).replace(/-/g, '.')
    : 'UNDATED';

/*
 * Tile heights are not set here at all — each tile carries its manifest
 * aspect-ratio and CSS resolves the height from the real column width.
 *
 * The mockup used hand-picked pixel heights, and reproducing that meant
 * assuming a column width, which is wrong twice over: the column is a fraction
 * of the viewport, so a fixed height crops every tile at any other window size;
 * and clamping the range flattened the only genuine variety these photos have
 * (99 landscape at 3:2, 19 portrait — the portraits are the rhythm).
 */

const shown = page ? page.currentPage * PHOTOS_PAGE_SIZE : items.length;
const remaining = Math.max(0, total - shown);
---

<BaseLayout
  title="Photographs"
  description={`${total} photographs, ${yearSpan}.`}
  active="photos"
  back={true}
>
  <section class="sheet-page">
    <div class="sheet-head">
      <div>
        <h1 class="sheet-title" data-fx="resolve">Photographs</h1>
        <p class="sheet-lede">
          {total} frames, {yearSpan}.
        </p>
      </div>
      <div class="sheet-stats">
        {total} FRAMES<br />{distinctYears} YEARS<br />{yearSpan}
      </div>
    </div>

    {
      items.length === 0 ? (
        <p class="sheet-empty">
          No photos yet. Run <code>npm run photos:import -- &lt;path&gt;</code>.
        </p>
      ) : (
        <div class="sheet">
          {items.map((photo, i) => (
            <PhotoThumb
              photo={photo}
              sizes={SIZES}
              label={label(photo)}
              meta={meta(photo)}
              index={i}
              loading={i < 8 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
      )
    }

    {
      page && page.lastPage > 1 && (
        <nav class="sheet-more" aria-label="Pagination">
          {page.url.prev ? (
            <a href={page.url.prev} rel="prev" class="sheet-more-link">
              <span class="sheet-more-rule" />
              NEWER
            </a>
          ) : (
            <span class="sheet-more-rule" />
          )}

          <span class="sheet-more-at">
            PAGE {page.currentPage} / {page.lastPage}
          </span>

          {page.url.next ? (
            <a href={page.url.next} rel="next" class="sheet-more-link">
              LOAD {remaining} MORE
              <span class="sheet-more-rule" />
            </a>
          ) : (
            <span class="sheet-more-rule" />
          )}
        </nav>
      )
    }
  </section>

  <script>
    import '../../scripts/lightbox';
  </script>
</BaseLayout>

<style>
  .sheet-page {
    position: relative;
    padding: 96px var(--gutter) 70px;
  }

  .sheet-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 22px;
  }

  .sheet-title {
    margin: 0;
    font: 700 62px/1 var(--display);
    letter-spacing: -0.05em;
    color: var(--tx-hi);
  }

  .sheet-lede {
    margin: 14px 0 0;
    max-width: 520px;
    font: 400 12px/1.8 var(--mono);
    color: var(--dim);
  }

  .sheet-stats {
    text-align: right;
    font: 400 9.5px/1.8 var(--mono);
    letter-spacing: 0.16em;
    color: var(--faint);
    white-space: nowrap;
  }

  .sheet-empty {
    font: 400 12px/1.8 var(--mono);
    color: var(--dim);
  }

  .sheet-empty code {
    color: var(--cyan);
  }

  /*
   * column-count, not a packing algorithm. It orders items down each column
   * rather than across, so strict chronology reads oddly — accepted here
   * because a contact sheet is browsed, not read. docs/ARCHITECTURE.md §6.
   */
  .sheet {
    column-count: 4;
    column-gap: 12px;
    padding-top: 22px;
  }

  .sheet :global(.tile) {
    break-inside: avoid;
    margin-bottom: 12px;
  }

  .sheet-more {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding-top: 20px;
    font: 500 10px var(--mono);
    letter-spacing: 0.2em;
    color: var(--faint);
  }

  .sheet-more-link {
    display: flex;
    align-items: center;
    gap: 14px;
    color: var(--dim);
    transition: color 0.16s;
  }

  .sheet-more-link:hover {
    color: var(--cyan);
  }

  .sheet-more-rule {
    display: block;
    width: 40px;
    height: 1px;
    background: rgba(142, 180, 255, 0.3);
  }

  .sheet-more-at {
    color: var(--faint);
  }
</style>

<style is:global>
  /* ---------------------------------------------------------------------
   * Lightbox. Global because src/scripts/lightbox.ts builds this subtree at
   * runtime, so Astro's scoped-style attributes would never reach it.
   * ------------------------------------------------------------------- */

  .lb {
    position: fixed;
    inset: 0;
    z-index: 40;
    animation: lbIn 0.24s cubic-bezier(0.2, 0.85, 0.2, 1);
  }

  .lb[hidden] {
    display: none;
  }

  /*
   * Ambient bloom — a blurred, saturated copy of the photograph sitting behind
   * itself. Mockup 6b, and Signal 4c states the reasoning: "ambient bloom is a
   * blurred copy of the photo itself, so it works on real images". No colour is
   * ever extracted or stored; the glow is the photo.
   */
  .lb-bloom {
    position: absolute;
    inset: -12%;
    background-position: center;
    background-size: cover;
    filter: blur(80px) saturate(1.4);
    opacity: 0.5;
    transform: scale(1.16);
    transition: background-image 0.45s ease;
    pointer-events: none;
  }

  /*
   * The base backdrop. The bloom stacks *above* this, not below — putting the
   * wash on top drowns the bloom entirely, which is what happened on the first
   * attempt. Order in the DOM is wash → bloom → vignette, as in the mockup.
   */
  .lb-wash {
    position: absolute;
    inset: 0;
    background: rgba(3, 4, 10, 0.9);
  }

  .lb-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      72% 58% at 50% 46%,
      transparent,
      rgba(3, 4, 10, 0.88) 78%
    );
  }

  .lb-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 30px;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
  }

  .lb-counter {
    color: var(--cyan);
  }

  .lb-close {
    background: none;
    border: 0;
    padding: 0;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
    cursor: pointer;
    transition: color 0.16s;
  }

  .lb-close:hover {
    color: #fff;
  }

  .lb-stage {
    position: absolute;
    left: 0;
    right: 0;
    top: 52px;
    bottom: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 14px 30px 0;
  }

  .lb-nav {
    flex: none;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(220, 240, 255, 0.18);
    background: none;
    color: #c2cee0;
    cursor: pointer;
    font: 400 13px var(--mono);
    transition: all 0.16s;
  }

  .lb-nav:hover {
    border-color: #fff;
    color: #fff;
    box-shadow: 0 0 22px -8px #fff;
  }

  .lb-frame {
    position: relative;
    margin: 0;
    max-width: 820px;
    max-height: 100%;
    box-shadow: 0 34px 90px -30px rgba(0, 0, 0, 0.95);
  }

  .lb-img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lb-bracket {
    position: absolute;
    width: 18px;
    height: 18px;
    pointer-events: none;
  }

  .lb-tl {
    left: -1px;
    top: -1px;
    border-left: 2px solid var(--cyan);
    border-top: 2px solid var(--cyan);
  }

  .lb-tr {
    right: -1px;
    top: -1px;
    border-right: 2px solid var(--cyan);
    border-top: 2px solid var(--cyan);
  }

  .lb-bl {
    left: -1px;
    bottom: -1px;
    border-left: 2px solid var(--cyan);
    border-bottom: 2px solid var(--cyan);
  }

  .lb-br {
    right: -1px;
    bottom: -1px;
    border-right: 2px solid var(--cyan);
    border-bottom: 2px solid var(--cyan);
  }

  .lb-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 96px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 30px;
  }

  .lb-foot-inner {
    width: 820px;
    max-width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .lb-thumbs {
    display: flex;
    gap: 7px;
  }

  /* Dim until hovered — the same "one thing lights at a time" rule as the sheet. */
  .lb-thumb {
    width: 64px;
    height: 44px;
    padding: 0;
    border: 0;
    background-color: var(--ink);
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    cursor: pointer;
    transition: opacity 0.16s;
  }

  .lb-thumb:hover {
    opacity: 1;
  }

  .lb-thumb[aria-current='true'] {
    opacity: 1;
    outline: 1px solid rgba(255, 255, 255, 0.9);
    outline-offset: 1px;
    box-shadow: 0 0 18px -4px #fff;
  }

  .lb-title {
    font: 700 24px var(--display);
    letter-spacing: -0.025em;
    color: var(--tx-hi);
  }

  .lb-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.18em;
    color: var(--dim);
  }

  .lb-dash {
    width: 20px;
    height: 2px;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
  }
</style>
