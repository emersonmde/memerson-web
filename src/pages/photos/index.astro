---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoTile from '../../components/PhotoTile.astro';
import { groupIntoRuns, type ShootRecord } from '../../lib/runs';
import { hueForIndex } from '../../lib/ramp';
import shootsData from '../../data/shoots.json';

/**
 * The gallery. See docs/UI-DESIGN.md §7 and §10.
 *
 * One page, not a paginated sheet. Every part of the redesign — the run
 * headers, the margin rail, the stray-frame rule, the tag filter — needs the
 * whole library at once to be truthful about coverage, and a rail that only
 * knows about the frames loaded so far is worse than no rail. So all frames are
 * rendered here, statically, with their images lazy-loaded. No runtime fetching
 * of any kind: the constraint that killed the old AWS gallery still holds.
 *
 * The three views are the same frames arranged three ways, and the script
 * *moves* the tiles between arrangements rather than re-rendering them — so
 * switching views never re-downloads an image and never needs a second copy of
 * the manifest on the page.
 */

const shoots = shootsData as Record<string, ShootRecord>;

const photos = (await getCollection('photos')).sort(
  (a, b) => (b.data.takenAt?.valueOf() ?? 0) - (a.data.takenAt?.valueOf() ?? 0),
);

const runs = groupIntoRuns(
  photos.map((p) => ({ ...p, shoot: p.data.shoot })),
  shoots,
);

const years = photos
  .map((p) => p.data.takenAt?.getUTCFullYear())
  .filter(Boolean) as number[];
const yearSpan = years.length ? `${Math.min(...years)} — ${Math.max(...years)}` : '';

const outings = runs.filter((r) => !r.stray).length;
const strays = runs.filter((r) => r.stray).reduce((n, r) => n + r.items.length, 0);

const MONTH = [
  'JAN',
  'FEB',
  'MAR',
  'APR',
  'MAY',
  'JUN',
  'JUL',
  'AUG',
  'SEP',
  'OCT',
  'NOV',
  'DEC',
];

/** "2022-10-29" → "2022.10.29" — the site's date voice everywhere but prose. */
const dots = (iso: string) => iso.replace(/-/g, '.');

/** "2022-10-29" → "29 OCT 2022", for the editorial lead only. */
const longDate = (iso: string) => {
  const [y, m, d] = iso.split('-');
  return `${Number(d)} ${MONTH[Number(m) - 1]} ${y}`;
};

const isoOf = (p: (typeof photos)[number]) =>
  p.data.takenAt?.toLocaleDateString('en-CA', { timeZone: 'UTC' }) ?? '';

/** Runs are newest-first, so items[0] is the latest frame and the last the earliest. */
const spanOf = (items: (typeof photos)[number][]) => {
  const dates = items.map(isoOf).filter(Boolean);
  const newest = dates[0];
  const oldest = dates[dates.length - 1];
  return newest === oldest ? dots(newest) : `${dots(oldest)} — ${dots(newest)}`;
};

const dayCount = (items: (typeof photos)[number][]) =>
  new Set(items.map(isoOf).filter(Boolean)).size;

const runName = (name: string | null, shoot: string | null) =>
  name ?? (shoot ? dots(shoot) : 'UNDATED');

/*
 * A tile is labelled with its *own* shoot, not with the run it ended up in. A
 * stray stretch has no name — but the one-off shoots inside it usually do, and
 * dropping "Stuffed Lion Toy" because its outing was a single frame would lose
 * the only label that frame has.
 */
const shootNameOf = (shoot: string | null) => shoots[shoot ?? '']?.name ?? null;

/*
 * Eager for the first screenful only. Everything else is lazy, which is what
 * makes a 118-frame page cost about as much on arrival as a 30-frame one did.
 */
let rendered = 0;
const EAGER = 8;
---

<BaseLayout
  title="Photographs"
  description={`${photos.length} photographs, ${yearSpan}.`}
  active="photos"
  back={true}
>
  <section class="px-page">
    {
      /*
        The room's light. Two stacked layers so the backdrop can cross-fade:
        the script paints the incoming shoot's LQIP onto the hidden layer and
        swaps opacities. Without JavaScript the layers simply stay empty and
        the page is lit by the sky alone.
      */
    }
    <div class="px-ambient" aria-hidden="true">
      <div class="px-amb" data-amb></div>
      <div class="px-amb" data-amb></div>
    </div>
    <div class="px-head">
      <div>
        <h1 class="px-title neon-h" data-fx="resolve">Photographs</h1>
        <p class="px-lede">
          Shot mostly for myself. Grouped by the day they were taken — the outing is the
          only unit that has ever mattered.
        </p>
      </div>
      {
        /* Each line is its own element: below 900px this becomes a wrapping
          flex row, and bare text nodes separated by <br> cannot take a gap. */
      }
      <div class="px-stats">
        <span><b>{photos.length} FRAMES</b></span>
        <span>{outings} OUTINGS{strays > 0 && ` + ${strays} STRAYS`}</span>
        <span>{yearSpan}</span>
      </div>
    </div>

    {
      photos.length === 0 ? (
        <p class="px-empty">
          No frames yet. Run <b>npm run photos:import -- &lt;path&gt;</b>.
        </p>
      ) : (
        <>
          {/*
            The controls are progressive enhancement: without the script the page
            is still the complete gallery in RUNS order, every tile still links to
            its photograph, and the rail below is real anchors.
          */}
          <div class="px-bar" data-bar>
            <span class="px-bar-label">VIEW</span>
            <div class="px-seg" data-seg role="group" aria-label="Gallery view">
              <button type="button" data-layout="sheet" aria-pressed="false">
                SHEET
              </button>
              <button type="button" data-layout="runs" aria-pressed="true">
                RUNS
              </button>
              <button type="button" data-layout="editorial" aria-pressed="false">
                EDITORIAL
              </button>
            </div>
            <button type="button" class="px-jump" data-jump-open aria-haspopup="dialog">
              SHOOTS ▾
            </button>
            <span class="px-count" data-count aria-live="polite">
              <b>{photos.length}</b> FRAMES
            </span>
            <span class="px-find">
              <input
                type="search"
                data-find
                placeholder="TAG, CAMERA, YEAR, SHOOT"
                aria-label="Filter frames"
              />
              <span class="px-key" aria-hidden="true">
                /
              </span>
            </span>
          </div>

          <div class="px-q" data-qbar hidden>
            <span class="px-q-text" />
            <button type="button" class="btn-ghost px-q-clear" data-qclear>
              CLEAR ×
            </button>
          </div>

          <p class="px-empty" data-empty hidden />

          <div data-sheet data-layout="runs">
            {runs.map((run, runIndex) => (
              <section class="px-run" id={run.key} data-run data-shoot={run.key}>
                <div class:list={['px-run-head', run.stray && 'is-stray']}>
                  <span class="px-run-date">
                    {run.stray ? spanOf(run.items) : dots(run.shoot ?? '')}
                  </span>
                  <span class="px-run-rule" />
                  <span class="px-run-name">
                    {run.stray
                      ? 'STRAY FRAMES'
                      : runName(run.name, run.shoot).toUpperCase()}
                  </span>
                  {run.series && (
                    <button type="button" class="px-run-series" data-series={run.series}>
                      {run.series.toUpperCase()}
                    </button>
                  )}
                  <span class="px-run-aside">
                    {run.stray
                      ? `${run.items.length} FRAMES / ${dayCount(run.items)} SEPARATE DAY${dayCount(run.items) > 1 ? 'S' : ''}, NO OUTING`
                      : `${run.items.length} FRAME${run.items.length > 1 ? 'S' : ''}${run.cameras.length ? ` / ${run.cameras.join(', ').toUpperCase()}` : ''}`}
                  </span>
                </div>

                {/*
                  The editorial lead's title block. Rendered here and hidden by CSS
                  in the other two views — the script moves it, it does not build it,
                  so nothing on this page is assembled from a second data payload.
                */}
                {!run.stray && (
                  <div class="px-lead-meta" data-lead-meta>
                    <div class="px-lead-kicker">{dots(run.shoot ?? '')}</div>
                    <h2 class="px-lead-title">{runName(run.name, run.shoot)}</h2>
                    <div class="px-lead-line" />
                    <div class="px-lead-sub">
                      {run.summary && (
                        <>
                          {run.summary}
                          <br />
                        </>
                      )}
                      {run.items.length} frames · {run.shoot ? longDate(run.shoot) : ''}
                    </div>
                  </div>
                )}

                <div class="px-sheet" data-grid>
                  {run.items.map((photo) => (
                    <PhotoTile
                      photo={photo}
                      shootName={shootNameOf(photo.data.shoot)}
                      series={shoots[photo.data.shoot ?? '']?.series ?? null}
                      accent={run.stray ? null : hueForIndex(runIndex, runs.length)}
                      loading={rendered++ < EAGER ? 'eager' : 'lazy'}
                    />
                  ))}
                </div>
              </section>
            ))}
          </div>
        </>
      )
    }
  </section>

  {
    runs.length > 1 && (
      <nav class="px-rail" data-rail aria-label="Shoots">
        {runs.map((run) => (
          <a
            class:list={['px-rail-item', run.stray && 'is-stray']}
            href={`#${run.key}`}
            data-rail-item
            data-shoot={run.key}
          >
            <span>
              {run.stray ? 'STRAY FRAMES' : runName(run.name, run.shoot).toUpperCase()}
            </span>
            <span class="px-rail-n">{run.items.length}</span>
            <i aria-hidden="true" />
          </a>
        ))}
      </nav>
    )
  }

  {/* The rail, folded into a list you summon — below 1240px there is no margin. */}
  <div
    class="px-jumpsheet"
    data-jump
    role="dialog"
    aria-label="Jump to a shoot"
    aria-modal="true"
  >
    <button type="button" class="px-jumpsheet-close" data-jump-close>CLOSE ×</button>
    <div class="px-jumpsheet-in">
      <h2>Shoots</h2>
      <p>JUMP TO AN OUTING</p>
      <div>
        {
          runs.map((run) => (
            <a
              class:list={['px-jumprow', run.stray && 'is-stray']}
              href={`#${run.key}`}
              data-jump-row
            >
              <span class="j-date">
                {run.stray ? spanOf(run.items) : dots(run.shoot ?? '')}
              </span>
              <span class="j-name">
                {run.stray ? 'Stray frames' : runName(run.name, run.shoot)}
              </span>
              <span class="j-n">{run.items.length}</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  {/* The viewer. Inert until the script wires it up. */}
  <div
    class="lb"
    data-lb
    role="dialog"
    aria-modal="true"
    aria-label="Photo viewer"
    hidden
  >
    <div class="lb-wash" data-lb-close></div>
    <div class="lb-bloom"></div>
    <div class="lb-vignette"></div>
    <div class="lb-bar">
      <span class="lb-counter"></span>
      <button type="button" class="lb-close" data-lb-close>
        CLOSE <span class="lb-close-key">ESC</span> ×
      </button>
    </div>
    <div class="lb-stage">
      <button type="button" class="lb-nav" data-lb-step="-1" aria-label="Previous photo"
        >←</button
      >
      <figure class="lb-frame">
        {
          /* No <picture>: a <source> would override the cached URL the script
            paints first, which is the whole point of the sequence. */
        }
        <img class="lb-img" alt="" />
        <span class="lb-bracket lb-tl"></span>
        <span class="lb-bracket lb-tr"></span>
        <span class="lb-bracket lb-bl"></span>
        <span class="lb-bracket lb-br"></span>
      </figure>
      <button type="button" class="lb-nav" data-lb-step="1" aria-label="Next photo"
        >→</button
      >
    </div>
    <aside class="lb-exif" data-lb-exif aria-label="Capture data">
      <h3>
        CAPTURE DATA
        <button type="button" class="lb-exif-close" data-lb-exif-close>CLOSE ×</button>
      </h3>
      <dl></dl>
      <p class="lb-exif-note"></p>
    </aside>
    <div class="lb-foot">
      <div class="lb-foot-inner">
        <div>
          <div class="lb-titleline"><div class="lb-title"></div></div>
          <div class="lb-meta">
            <span class="lb-dash"></span>
            <button type="button" class="lb-shoot"></button>
            <span class="lb-meta-text"></span>
          </div>
          <div class="lb-tags"></div>
        </div>
        <div class="lb-right">
          {/* Keyboard hints where there is a keyboard; real controls on touch. */}
          <div class="lb-hint">
            <span><b>I</b> CAPTURE DATA</span><span><b>← →</b> MOVE</span>
          </div>
          <div class="lb-thumbs"></div>
          <div class="lb-controls">
            <button
              type="button"
              class="lb-step"
              data-lb-step="-1"
              aria-label="Previous photo">←</button
            >
            <button type="button" class="lb-step" data-lb-step="1" aria-label="Next photo"
              >→</button
            >
            <button
              type="button"
              class="btn-ghost lb-info"
              aria-pressed="false"
              aria-label="Capture data">i</button
            >
          </div>
        </div>
      </div>
      <div class="lb-swipe">SWIPE ← → TO MOVE &nbsp;·&nbsp; SWIPE DOWN TO CLOSE</div>
    </div>
  </div>

  <script>
    import '../../scripts/photos';
  </script>
</BaseLayout>

<style is:global>
  /* -------------------------------------------------------------------------
   * The gallery. Global rather than scoped because the script moves tiles
   * between arrangements and builds the editorial `.px-lead` wrapper at
   * runtime, and a scope attribute would never reach a node it created.
   * ---------------------------------------------------------------------- */

  /*
   * The shoot rail is fixed to the right edge, so the scroll has to give it a
   * margin to live in — otherwise it prints over the last column and becomes
   * unreadable the moment a bright frame scrolls under it. That margin is the
   * whole reason the rail folds into the SHOOTS sheet below 1240px: there is no
   * room to reserve down there.
   *
   * `--rail-w` is 0 by default and only set where the rail is actually shown,
   * so every full-bleed element below can budget for it with one expression.
   */
  .px-page {
    --rail-w: 0px;
    position: relative;
    padding: 34px calc(var(--gutter) + var(--rail-w)) 90px var(--gutter);
  }

  @media (min-width: 1241px) {
    .px-page {
      --rail-w: 280px;
    }
  }

  .px-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    padding-bottom: 20px;
  }

  .px-title {
    margin: 0;
    font: 700 62px/1 var(--display);
    letter-spacing: -0.05em;
    color: var(--tx-hi);
  }

  .px-lede {
    margin: 14px 0 0;
    max-width: 520px;
    font: 400 12px/1.8 var(--mono);
    color: var(--dim);
  }

  .px-stats {
    text-align: right;
    font: 400 9.5px/1.8 var(--mono);
    letter-spacing: 0.16em;
    color: var(--faint);
    white-space: nowrap;
  }

  .px-stats span {
    display: block;
  }

  .px-stats b {
    color: var(--dim);
    font-weight: 400;
  }

  /* ---- control bar: reads as the site's .sec-head, not a web toolbar ---- */

  .px-bar {
    position: sticky;
    top: var(--nav-h);
    z-index: 7;
    display: flex;
    align-items: center;
    gap: 16px;
    height: 38px;
    margin: 0 calc((var(--gutter) + var(--rail-w)) * -1) 22px calc(var(--gutter) * -1);
    padding: 0 calc(var(--gutter) + var(--rail-w)) 0 var(--gutter);
    background: rgba(3, 4, 10, 0.94);
    backdrop-filter: blur(10px);
    border-top: 1px solid var(--hairline-soft);
    border-bottom: 1px solid var(--hairline-soft);
    font: 500 9.5px var(--mono);
    letter-spacing: 0.22em;
    color: var(--faint);
  }

  .px-seg {
    display: flex;
  }

  .px-seg button {
    font: 500 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: #9fb0c8;
    background: none;
    border: 1px solid rgba(142, 180, 255, 0.16);
    border-right: 0;
    padding: 5px 12px;
    cursor: pointer;
    transition: all 0.16s;
  }

  .px-seg button:last-child {
    border-right: 1px solid rgba(142, 180, 255, 0.16);
  }

  .px-seg button:hover {
    color: var(--tx-hi);
    background: rgba(255, 255, 255, 0.04);
  }

  .px-seg button[aria-pressed='true'] {
    color: var(--void);
    background: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 22px -8px var(--cyan);
  }

  .px-jump {
    display: none;
    align-items: center;
    gap: 7px;
    font: 500 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: #9fb0c8;
    background: none;
    border: 1px solid rgba(142, 180, 255, 0.16);
    padding: 6px 11px;
    cursor: pointer;
    transition: all 0.16s;
  }

  .px-jump:hover {
    color: var(--tx-hi);
    border-color: var(--cyan);
  }

  .px-find {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-left: auto;
  }

  .px-find input {
    width: 190px;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.14em;
    color: var(--tx);
    background: none;
    border: 0;
    border-bottom: 1px solid var(--hairline);
    padding: 5px 2px;
    outline: 0;
    transition: border-color 0.16s;
  }

  .px-find input::placeholder {
    color: var(--faint-2);
    letter-spacing: 0.18em;
  }

  .px-find input:focus {
    border-color: var(--cyan);
  }

  .px-key {
    border: 1px solid var(--hairline);
    padding: 2px 5px;
    color: var(--faint);
  }

  .px-count {
    color: var(--dim);
  }

  .px-count b {
    color: var(--cyan);
    font-weight: 500;
  }

  /* ---- query / tag results header ---- */

  .px-q {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
    padding: 13px 16px;
    border: 1px solid var(--hairline);
    border-left: 2px solid var(--sodium);
    background: rgba(8, 11, 19, 0.86);
    font: 400 10px var(--mono);
    letter-spacing: 0.18em;
    color: var(--dim);
  }

  .px-q b {
    color: var(--sodium);
    font-weight: 500;
  }

  .px-q .px-q-clear {
    margin-left: auto;
  }

  /* ---- the sheet ---- */

  .px-sheet {
    column-count: 4;
    column-gap: 12px;
  }

  .px-sheet .px-tile {
    break-inside: avoid;
    margin-bottom: 12px;
  }

  @media (max-width: 1100px) {
    .px-sheet {
      column-count: 3;
    }
  }

  @media (max-width: 720px) {
    .px-sheet {
      column-count: 2;
    }
  }

  .px-tile {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--ink);
    cursor: pointer;
    /* Entry state; `.is-in` resolves it. Set here so a tile never flashes. */
    opacity: 0;
    filter: blur(9px);
    transform: translateY(12px) scale(0.985);
  }

  .px-tile img {
    display: block;
    width: 100%;
    aspect-ratio: var(--ar);
    object-fit: cover;
  }

  /*
   * A gallery arrived at by swap is already developed.
   *
   * The entry state above is `opacity: 0`, and `::view-transition-new(root)` is
   * captured before this page's script has run — so the wipe was revealing an
   * empty grid and holding it for its whole 380ms, then fading 118 frames in at
   * once. See the note in `src/scripts/redraw.ts`; the heading has the same
   * gate in global.css.
   */
  html[data-swapped] .px-tile {
    opacity: 1;
    filter: none;
    transform: none;
  }

  .px-tile.is-in {
    opacity: 1;
    filter: none;
    transform: none;
    transition:
      opacity 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .px-tile.is-in:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 54px -18px var(--cyan);
    transition:
      transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.2s;
  }

  .px-wash {
    position: absolute;
    inset: 0;
    background: rgba(3, 4, 10, 0.18);
    transition: background 0.2s;
    pointer-events: none;
  }

  .px-tile:hover .px-wash {
    background: linear-gradient(rgba(0, 0, 0, 0) 42%, rgba(3, 4, 10, 0.78));
  }

  .px-cap {
    position: absolute;
    left: 9px;
    right: 9px;
    bottom: 8px;
    display: block;
    opacity: 0;
    transform: translateY(4px);
    transition:
      opacity 0.2s,
      transform 0.2s;
    pointer-events: none;
    text-shadow: 0 1px 8px rgba(3, 4, 10, 0.95);
  }

  .px-tile:hover .px-cap {
    opacity: 1;
    transform: none;
  }

  .px-cap-t {
    display: block;
    font: 500 11px/1.35 var(--display);
    letter-spacing: -0.01em;
    color: #fff;
  }

  .px-cap-m {
    display: block;
    margin-top: 3px;
    font: 400 8px var(--mono);
    letter-spacing: 0.16em;
    color: #a9bdd6;
  }

  .px-idx {
    position: absolute;
    top: 8px;
    right: 9px;
    opacity: 0;
    transition: opacity 0.2s;
    font: 400 8px var(--mono);
    letter-spacing: 0.12em;
    color: #c7d2e2;
    text-shadow: 0 1px 6px rgba(3, 4, 10, 0.9);
  }

  .px-tile:hover .px-idx {
    opacity: 1;
  }

  .px-bracket {
    position: absolute;
    width: 9px;
    height: 9px;
    opacity: 0;
    transition: opacity 0.2s;
    pointer-events: none;
  }

  .px-tile:hover .px-bracket {
    opacity: 1;
  }

  .px-b-tl {
    top: 5px;
    left: 5px;
    border-left: 1px solid var(--cyan);
    border-top: 1px solid var(--cyan);
  }

  .px-b-br {
    bottom: 5px;
    right: 5px;
    border-right: 1px solid var(--cyan);
    border-bottom: 1px solid var(--cyan);
  }

  /* ---- runs ---- */

  /* ---- the ambient light ---- */

  /*
   * The lightbox lights its frame with the photograph; this lights the whole
   * page with the shoot in view. A LQIP, blurred beyond recognition, becomes
   * the colour of the air — scroll from stage lights into an autumn outing and
   * the room changes with you.
   *
   * Viewport-fixed, deliberately — unlike the log and about blooms, which are
   * anchored to the page top like the hero's haze. This one is the *room's*
   * light, not the arrival's: it must be wherever you are for the cross-fade
   * between shoots to mean anything. (Owner review 2026-07-29: briefly
   * top-anchored with the others, reverted the same day.)
   *
   * z-index -1: inside `.page`'s stacking context it paints behind every
   * plate and tile but still above the sky. The dimming gradient in ::after
   * keeps type and thumbnails on spec whatever the photograph is doing.
   */
  .px-ambient {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .px-amb {
    position: absolute;
    inset: -14%;
    background: center / cover no-repeat;
    filter: blur(80px) saturate(1.25);
    opacity: 0;
    transition: opacity 1.6s ease;
  }

  .px-amb.is-on {
    opacity: 0.38;
  }

  .px-ambient::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(3, 4, 10, 0.62),
      rgba(3, 4, 10, 0.3) 34%,
      rgba(3, 4, 10, 0.55) 100%
    );
  }

  .px-run {
    position: relative;
    padding-bottom: 34px;
    /* The nav, the control bar and the run header all sit above an anchor. */
    scroll-margin-top: calc(var(--nav-h) + var(--bar-h, 38px) + 44px);
  }

  .px-run-head {
    position: sticky;
    top: calc(var(--nav-h) + var(--bar-h, 38px));
    z-index: 6;
    display: flex;
    align-items: center;
    gap: 14px;
    height: 34px;
    margin: 0 calc((var(--gutter) + var(--rail-w)) * -1) 14px calc(var(--gutter) * -1);
    padding: 0 calc(var(--gutter) + var(--rail-w)) 0 var(--gutter);
    background: rgba(3, 4, 10, 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline-soft);
    font: 500 9.5px var(--mono);
    letter-spacing: 0.24em;
    color: var(--dim);
  }

  .px-run-date {
    color: var(--cyan);
  }

  /* The run that owns the screen glows in its own light. */
  .px-run.is-live .px-run-date {
    color: var(--live, var(--cyan));
    text-shadow: 0 0 14px var(--live, transparent);
  }

  .px-run-rule {
    width: 20px;
    height: 1px;
    background: var(--hairline-strong);
  }

  .px-run-name {
    color: var(--tx-hi);
  }

  .px-run-aside {
    margin-left: auto;
    color: var(--faint);
    letter-spacing: 0.16em;
  }

  /*
   * A series is the thread joining recurring outings — two Air Show shoots, one
   * `series: air-shows`. It hangs off the run header rather than earning a page
   * of its own, because most of the library belongs to no series at all.
   */
  .px-run-series {
    font: inherit;
    color: var(--violet);
    background: none;
    border: 1px solid rgba(142, 180, 255, 0.16);
    padding: 2px 7px;
    letter-spacing: 0.16em;
    cursor: pointer;
    transition: all 0.16s;
  }

  .px-run-series:hover {
    color: var(--void);
    background: var(--violet);
    border-color: var(--violet);
    box-shadow: 0 0 20px -6px var(--violet);
  }

  /* A stretch of one-offs is not an outing, so the header steps back. */
  .px-run-head.is-stray {
    border-bottom-style: dashed;
    border-bottom-color: rgba(142, 180, 255, 0.08);
  }

  .px-run-head.is-stray .px-run-date {
    color: var(--faint);
  }

  .px-run-head.is-stray .px-run-name {
    color: var(--dim);
  }

  .px-run-head.is-stray .px-run-rule {
    background: var(--hairline);
  }

  /* ---- editorial lead ---- */

  /* The lead block only exists as a lead in EDITORIAL; elsewhere it is markup. */
  [data-sheet]:not([data-layout='editorial']) .px-lead-meta {
    display: none;
  }

  .px-lead {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 26px;
    align-items: end;
    margin-bottom: 12px;
  }

  .px-lead .px-tile {
    margin: 0;
  }

  .px-lead-meta {
    padding-bottom: 6px;
  }

  .px-lead-kicker {
    font: 500 9.5px var(--mono);
    letter-spacing: 0.24em;
    color: var(--sodium);
  }

  .px-lead-title {
    margin: 12px 0 0;
    font: 700 40px/1.02 var(--display);
    letter-spacing: -0.045em;
    color: var(--tx-hi);
  }

  .px-lead-sub {
    margin-top: 12px;
    font: 400 11px/1.9 var(--mono);
    letter-spacing: 0.1em;
    color: var(--dim);
  }

  .px-lead-line {
    width: 44px;
    height: 2px;
    margin: 16px 0;
    background: var(--sodium);
    box-shadow: 0 0 12px var(--sodium);
  }

  @media (max-width: 900px) {
    .px-lead {
      grid-template-columns: 1fr;
    }
  }

  /* ---- shoot rail ---- */

  .px-rail {
    position: fixed;
    right: 16px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 8;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 0;
    text-align: right;
  }

  .px-rail-item {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 9px;
    padding: 5px 0;
    font: 400 8.5px var(--mono);
    letter-spacing: 0.18em;
    color: var(--faint-2);
    transition: color 0.18s;
  }

  .px-rail-item:hover {
    color: var(--tx);
  }

  .px-rail-item i {
    display: block;
    width: 14px;
    height: 1px;
    background: currentColor;
    transition:
      width 0.22s,
      background 0.18s;
  }

  .px-rail-item:hover i {
    width: 24px;
  }

  /*
   * The active entry takes `--live` — the hue sampled from the shoot on
   * screen, set by the script at the ramp's locked lightness and chroma.
   * One hue at a time, and always the photographs' own. Cyan is the
   * no-sample fallback (script off, grey shoot).
   */
  .px-rail-item[aria-current='true'] {
    color: var(--live, var(--cyan));
  }

  .px-rail-item[aria-current='true'] i {
    width: 30px;
    background: var(--live, var(--cyan));
    box-shadow: 0 0 10px var(--live, var(--cyan));
  }

  .px-rail-n {
    color: var(--faint-2);
    min-width: 18px;
    text-align: left;
  }

  .px-rail-item.is-stray {
    color: var(--faint-2);
  }

  .px-rail-item.is-stray[aria-current='true'] {
    color: var(--dim);
  }

  .px-rail-item.is-stray[aria-current='true'] i {
    background: var(--dim);
    box-shadow: none;
  }

  @media (max-width: 1240px) {
    .px-rail {
      display: none;
    }

    .px-jump {
      display: inline-flex;
    }
  }

  /* ---- the rail, folded into a summoned sheet ---- */

  .px-jumpsheet {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: none;
    background: rgba(3, 4, 10, 0.92);
    backdrop-filter: blur(8px);
    overflow-y: auto;
  }

  .px-jumpsheet.is-open {
    display: block;
  }

  .px-jumpsheet-in {
    max-width: 560px;
    margin: 0 auto;
    padding: calc(74px + env(safe-area-inset-top, 0px)) 22px
      calc(60px + env(safe-area-inset-bottom, 0px));
  }

  .px-jumpsheet h2 {
    margin: 0 0 4px;
    font: 700 30px/1 var(--display);
    letter-spacing: -0.04em;
    color: var(--tx-hi);
  }

  .px-jumpsheet p {
    margin: 0 0 22px;
    font: 400 10px/1.8 var(--mono);
    letter-spacing: 0.16em;
    color: var(--faint);
  }

  .px-jumprow {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 56px;
    padding: 12px 4px;
    border-bottom: 1px solid var(--hairline-soft);
    text-align: left;
    transition: background 0.16s;
  }

  .px-jumprow:hover,
  .px-jumprow:active {
    background: rgba(142, 180, 255, 0.06);
  }

  .px-jumprow .j-date {
    font: 400 9.5px var(--mono);
    letter-spacing: 0.14em;
    color: var(--cyan);
    min-width: 82px;
  }

  .px-jumprow .j-name {
    font: 500 14px var(--display);
    letter-spacing: -0.01em;
    color: var(--tx-hi);
  }

  .px-jumprow .j-n {
    margin-left: auto;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.14em;
    color: var(--faint);
  }

  .px-jumprow.is-stray .j-date,
  .px-jumprow.is-stray .j-name {
    color: var(--dim);
  }

  .px-jumpsheet-close {
    position: fixed;
    top: calc(16px + env(safe-area-inset-top, 0px));
    right: 16px;
    min-height: 44px;
    font: 500 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
    background: var(--chrome);
    border: 1px solid var(--hairline);
    padding: 0 16px;
    cursor: pointer;
  }

  .px-jumpsheet-close:hover {
    color: var(--tx-hi);
    border-color: var(--cyan);
  }

  /* ---- empty ---- */

  .px-empty {
    padding: 70px 0;
    font: 400 12px/1.9 var(--mono);
    color: var(--dim);
  }

  .px-empty b {
    color: var(--cyan);
    font-weight: 400;
  }

  @media (prefers-reduced-motion: reduce) {
    .px-tile {
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  /* -------------------------------------------------------------------------
   * Lightbox
   * ---------------------------------------------------------------------- */

  /*
   * The viewer is the one full-screen surface on the site, so it is where
   * `viewport-fit=cover` matters most: the wash and the bloom run edge to edge
   * under the notch and the home indicator, and only the chrome is inset.
   */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 40;
    --lb-t: env(safe-area-inset-top, 0px);
    --lb-b: env(safe-area-inset-bottom, 0px);
    /*
     * How far the backdrop layers run past the fixed box.
     *
     * A `position: fixed` element is laid out against the *small* viewport on
     * iOS — the area between the status bar and the floating tab bar — so a
     * wash at `inset: 0` stops dead at both, and the strips behind Safari's
     * translucent chrome show the page underneath instead of the viewer. The
     * layers themselves are not clipped (nothing here sets `overflow`), so
     * running them past the box is all it takes: the pixels land in the strips
     * and the backdrop reads as one continuous surface under the notch and the
     * home indicator. 220px clears the tallest of either.
     */
    --lb-over: 220px;
    animation: lbIn 0.24s cubic-bezier(0.2, 0.85, 0.2, 1);
  }

  .lb[hidden] {
    display: none;
  }

  /*
   * Ambient bloom — a blurred, saturated copy of the photograph sitting behind
   * itself. No colour is ever extracted or stored; the glow *is* the photo.
   */
  .lb-bloom {
    position: absolute;
    inset: -12%;
    background-position: center;
    background-size: cover;
    filter: blur(70px) saturate(2.2) brightness(1.35);
    opacity: 0.95;
    transform: scale(1.2);
    transition: background-image 0.45s ease;
    pointer-events: none;
  }

  /*
   * The base backdrop. The bloom stacks *above* this — putting the wash on top
   * drowns the bloom entirely. DOM order is wash → bloom → vignette.
   */
  .lb-wash {
    position: absolute;
    inset: calc(-1 * var(--lb-over)) 0;
    background: rgba(3, 4, 10, 0.82);
  }

  /*
   * The box overruns the viewport but the gradient must not be stretched with
   * it, or the falloff lands off-screen and the vignette all but disappears.
   * So the radial is sized back to the visible band and centred in it, and the
   * background *colour* — the gradient's own terminal value — fills the
   * overrun. The two meet at exactly the same colour, so there is no seam.
   */
  .lb-vignette {
    position: absolute;
    inset: calc(-1 * var(--lb-over)) 0;
    pointer-events: none;
    background-color: rgba(3, 4, 10, 0.88);
    background-image: radial-gradient(
      72% 58% at 50% 46%,
      transparent,
      rgba(3, 4, 10, 0.88) 78%
    );
    background-size: 100% calc(100% - 2 * var(--lb-over));
    background-position: 50% 50%;
    background-repeat: no-repeat;
  }

  .lb-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: calc(52px + var(--lb-t));
    display: flex;
    align-items: center;
    justify-content: space-between;
    /*
     * One shorthand. `padding-top: var(--lb-t)` followed by `padding: 0 30px`
     * resets the top inset back to zero, which is what put CLOSE under the
     * Dynamic Island with its focus ring and its `×` clipped by the status bar.
     */
    padding: var(--lb-t) 30px 0;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
  }

  .lb-counter {
    color: var(--cyan);
  }

  .lb-close {
    background: none;
    border: 0;
    padding: 0;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
    cursor: pointer;
    transition: color 0.16s;
  }

  .lb-close:hover {
    color: #fff;
  }

  .lb-close-key {
    color: var(--faint);
  }

  .lb-stage {
    position: absolute;
    inset: calc(52px + var(--lb-t)) 0 calc(156px + var(--lb-b));
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 14px 30px 0;
    transition: right 0.26s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* The drawer pushes the frame rather than covering it. */
  .lb.exif-open .lb-stage {
    right: 292px;
  }

  .lb-nav {
    flex: none;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(220, 240, 255, 0.18);
    background: none;
    color: #c2cee0;
    cursor: pointer;
    font: 400 13px var(--mono);
    transition: all 0.16s;
  }

  .lb-nav:hover {
    border-color: #fff;
    color: #fff;
    box-shadow: 0 0 22px -8px #fff;
  }

  /*
   * The frame wears the tile's LQIP while the full image is on the wire.
   *
   * Without it the viewer arrived in three separate events — an unsized image
   * laying out at the wrong place, then jumping as its intrinsic size landed,
   * then the bloom appearing behind it. The LQIP is a ~200-byte data URI that is
   * already in the document, so it costs no request and paints in the same frame
   * as everything else. The full image then resolves over it, which is the same
   * blur-to-sharp the headings and the tiles already use.
   */
  .lb-frame {
    position: relative;
    margin: 0;
    max-width: 900px;
    max-height: 100%;
    transform-origin: top left;
    background-size: cover;
    background-position: center;
    box-shadow: 0 34px 90px -30px rgba(0, 0, 0, 0.95);
  }

  .lb-img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /*
   * Crop marks, not an accent.
   *
   * These were cyan, and cyan is the site's "interactive edge" colour — which is
   * exactly wrong here, because the brackets are the one piece of chrome that
   * touches the photograph. Against a warm frame (sand, autumn, sodium light)
   * they read as a colour cast on the image rather than as a frame around it,
   * and no fixed hue from the ramp avoids that: whatever we pick fights the
   * complementary third of the library.
   *
   * Sampling a colour from the photo is not an option either — "the wash behind
   * a photo *is* the photo, nothing samples a palette" is a rule of the design.
   *
   * The answer is the ramp, sampled per *outing* rather than fixed. Lightness
   * and chroma are locked across it and only hue moves, so no sample can be
   * louder than another — and the mark then carries the same meaning the
   * mockup's album accents were reaching for: this frame is part of something,
   * and the colour says which. A stray frame belongs to no outing and keeps the
   * default cyan. The drop shadow keeps any of them legible on a bright corner.
   */
  .lb-frame {
    --bk: var(--cyan);
  }

  .lb-bracket {
    position: absolute;
    width: 18px;
    height: 18px;
    pointer-events: none;
    filter: drop-shadow(0 0 3px rgba(3, 4, 10, 0.7));
  }

  .lb-tl {
    left: -1px;
    top: -1px;
    border-left: 2px solid var(--bk);
    border-top: 2px solid var(--bk);
  }

  .lb-tr {
    right: -1px;
    top: -1px;
    border-right: 2px solid var(--bk);
    border-top: 2px solid var(--bk);
  }

  .lb-bl {
    left: -1px;
    bottom: -1px;
    border-left: 2px solid var(--bk);
    border-bottom: 2px solid var(--bk);
  }

  .lb-br {
    right: -1px;
    bottom: -1px;
    border-right: 2px solid var(--bk);
    border-bottom: 2px solid var(--bk);
  }

  .lb-foot {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    min-height: 96px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0 30px calc(18px + var(--lb-b));
  }

  .lb-foot-inner {
    width: 900px;
    max-width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }

  .lb-titleline {
    display: flex;
    align-items: baseline;
    gap: 14px;
  }

  .lb-title {
    max-width: 520px;
    font: 700 24px var(--display);
    letter-spacing: -0.025em;
    color: var(--tx-hi);
  }

  .lb-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.18em;
    color: var(--dim);
  }

  .lb-dash {
    width: 20px;
    height: 2px;
    background: var(--cyan);
    box-shadow: 0 0 10px var(--cyan);
  }

  .lb-shoot {
    font: 500 9.5px var(--mono);
    letter-spacing: 0.2em;
    color: var(--sodium);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    transition: color 0.16s;
  }

  .lb-shoot:hover {
    color: var(--tx-hi);
  }

  /* Tags are the one thing that makes 390 of them navigation rather than decor. */
  .lb-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 11px;
    max-width: 560px;
  }

  .lb-tag {
    font: 400 9px var(--mono);
    letter-spacing: 0.1em;
    color: #9fb0c8;
    background: none;
    border: 1px solid rgba(142, 180, 255, 0.16);
    padding: 3px 8px;
    cursor: pointer;
    transition: all 0.16s;
  }

  .lb-tag:hover {
    color: var(--void);
    background: var(--cyan);
    border-color: var(--cyan);
    box-shadow: 0 0 20px -6px var(--cyan);
  }

  .lb-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
  }

  .lb-hint {
    display: flex;
    gap: 12px;
    font: 400 8.5px var(--mono);
    letter-spacing: 0.18em;
    color: var(--faint-2);
  }

  .lb-hint b {
    color: var(--faint);
    font-weight: 400;
  }

  .lb-thumbs {
    display: flex;
    gap: 7px;
  }

  /*
   * Swipe is the gesture, but a gesture with no visible affordance is a secret.
   * These are the same two actions the arrows give a mouse, in the row that was
   * otherwise empty next to `i`.
   */
  .lb-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .lb-step {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(220, 240, 255, 0.18);
    background: none;
    color: #c2cee0;
    cursor: pointer;
    font: 400 15px var(--mono);
  }

  .lb-step:active {
    border-color: #fff;
    color: #fff;
  }

  /* Dim until hovered — the same "one thing lights at a time" rule as the sheet. */
  .lb-thumb {
    width: 64px;
    height: 44px;
    padding: 0;
    border: 0;
    background-color: var(--ink);
    background-size: cover;
    background-position: center;
    opacity: 0.4;
    cursor: pointer;
    transition: opacity 0.16s;
  }

  .lb-thumb:hover {
    opacity: 1;
  }

  .lb-thumb[aria-current='true'] {
    opacity: 1;
    outline: 1px solid rgba(255, 255, 255, 0.9);
    outline-offset: 1px;
    box-shadow: 0 0 18px -4px #fff;
  }

  /*
   * Capture data, hidden until `i`. Never on by default: half the library is a
   * phone, where the settings were not an authored decision — the note below
   * says so rather than dressing an auto-exposure up as craft.
   */
  .lb-exif {
    position: absolute;
    top: 70px;
    right: 30px;
    width: 250px;
    z-index: 3;
    padding: 16px 18px;
    border: 1px solid var(--hairline);
    background: rgba(8, 11, 19, 0.95);
    opacity: 0;
    transform: translateX(14px);
    pointer-events: none;
    transition:
      opacity 0.22s cubic-bezier(0.2, 0.8, 0.2, 1),
      transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .lb-exif.is-open {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .lb-exif h3 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 0 12px;
    font: 500 9px var(--mono);
    letter-spacing: 0.26em;
    color: var(--faint);
  }

  /*
   * The panel needs its own way out. On the bottom-sheet layout it covers the
   * `i` that opened it, which left no way to dismiss it at all.
   */
  .lb-exif-close {
    display: none;
    font: 500 9px var(--mono);
    letter-spacing: 0.2em;
    color: var(--dim);
    background: none;
    border: 1px solid var(--hairline);
    padding: 8px 12px;
    cursor: pointer;
  }

  .lb-exif dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 7px 14px;
    margin: 0;
    font: 400 9.5px var(--mono);
    letter-spacing: 0.08em;
  }

  .lb-exif dt {
    color: var(--faint);
  }

  .lb-exif dd {
    margin: 0;
    color: var(--tx);
    text-align: right;
  }

  .lb-exif .lb-exif-note {
    margin: 13px 0 0;
    padding-top: 11px;
    border-top: 1px solid var(--hairline-soft);
    font: 400 9px/1.7 var(--mono);
    color: var(--faint);
    letter-spacing: 0.06em;
  }

  .lb-exif .lb-exif-note:empty {
    display: none;
  }

  .lb-swipe {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 10px);
    text-align: center;
    font: 400 8.5px var(--mono);
    letter-spacing: 0.22em;
    color: var(--faint-2);
  }
</style>

<style is:global>
  /* -------------------------------------------------------------------------
   * Small screens. Not a squeeze of the desktop layout — the three views do
   * different jobs, so they narrow differently. See docs/UI-DESIGN.md §9.
   * ---------------------------------------------------------------------- */

  /* ---------- 900: desktop chrome stops fitting ---------- */
  @media (max-width: 900px) {
    .px-page {
      padding: 26px var(--gutter) 70px;
    }

    .px-title {
      font: 700 clamp(42px, 8.6vw, 62px) / 0.98 var(--display);
      letter-spacing: -0.05em;
    }

    .px-head {
      display: block;
      padding-bottom: 16px;
    }

    .px-lede {
      max-width: none;
      margin-top: 11px;
      font-size: 11.5px;
    }

    .px-stats {
      display: flex;
      gap: 0 18px;
      flex-wrap: wrap;
      text-align: left;
      margin-top: 14px;
      line-height: 1.6;
    }

    .px-stats span {
      display: inline;
    }

    .px-find input {
      width: 130px;
    }

    /*
     * The metadata stack goes vertical here rather than at 720, so the
     * thumbnails can stay: they are the only thing on the page that says there
     * are other photographs to get to, and dropping them for one breakpoint
     * band and bringing them back for the next would be the wrong kind of
     * responsive.
     */
    .lb-foot-inner {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .lb-right {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      width: 100%;
    }

    .lb-thumbs {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .lb-thumbs::-webkit-scrollbar {
      display: none;
    }

    .lb-stage {
      inset: calc(52px + var(--lb-t)) 0 calc(190px + var(--lb-b));
    }
  }

  /* ---------- 720: two rows of controls, touch sizing ---------- */
  @media (max-width: 720px) {
    /* Two rows. The script measures the result into --bar-h so the sticky run
       headers and the anchor scroll-margin both follow it. */
    .px-bar {
      height: auto;
      min-height: 82px;
      flex-wrap: wrap;
      gap: 10px 12px;
      padding: 9px var(--gutter);
    }

    .px-bar-label {
      display: none;
    }

    .px-seg button {
      padding: 0 14px;
      min-height: 44px;
      letter-spacing: 0.16em;
    }

    .px-jump {
      order: 2;
      padding: 0 12px;
      min-height: 44px;
    }

    .px-count {
      order: 4;
      margin-left: auto;
    }

    .px-find {
      order: 5;
      flex-basis: 100%;
      margin-left: 0;
    }

    .px-find input {
      width: 100%;
      padding: 9px 2px;
      min-height: 44px;
    }

    .px-run-head {
      height: auto;
      min-height: 34px;
      padding: 8px var(--gutter);
      gap: 10px;
      flex-wrap: wrap;
      letter-spacing: 0.18em;
    }

    .px-run-aside {
      flex-basis: 100%;
      margin-left: 0;
      letter-spacing: 0.14em;
    }

    /* The title block moves above the lead frame rather than beside it. */
    .px-lead {
      grid-template-columns: 1fr;
      gap: 14px;
      align-items: start;
    }

    .px-lead-meta {
      order: -1;
      padding-bottom: 0;
    }

    .px-lead-title {
      font-size: clamp(28px, 7.4vw, 40px);
      margin-top: 9px;
    }

    .px-lead-line {
      margin: 12px 0;
    }

    /* Arrows and the thumbnail strip are mouse furniture; swipe replaces both. */
    .lb-bar {
      height: calc(48px + var(--lb-t));
      padding: var(--lb-t) var(--gutter) 0;
    }

    .lb-close {
      min-height: 44px;
      display: flex;
      align-items: center;
    }

    .lb-nav {
      display: none;
    }

    .lb-stage {
      inset: calc(48px + var(--lb-t)) 0 calc(196px + var(--lb-b));
      padding: 8px var(--gutter) 0;
      align-items: center;
    }

    .lb.exif-open .lb-stage {
      right: 0;
    }

    .lb-frame {
      max-width: 100%;
      width: 100%;
    }

    .lb-img {
      width: 100%;
      height: auto;
      max-height: 100%;
      margin: 0 auto;
    }

    .lb-foot {
      min-height: 0;
      padding: 0 var(--gutter) calc(18px + var(--lb-b));
    }

    .lb-title {
      font-size: 19px;
      max-width: none;
    }

    .lb-meta {
      margin-top: 6px;
      font-size: 9px;
      letter-spacing: 0.14em;
    }

    /* Eight tags would wrap to four lines; scroll them instead. */
    .lb-tags {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-top: 10px;
      max-width: none;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .lb-tags::-webkit-scrollbar {
      display: none;
    }

    .lb-tag {
      flex: none;
      padding: 7px 10px;
      min-height: 36px;
      display: flex;
      align-items: center;
    }

    /* There is no keyboard here, so the keyboard hint goes and the controls
       it described appear instead. */
    .lb-hint {
      display: none;
    }

    .lb-step {
      display: flex;
    }

    .lb-close-key {
      display: none;
    }

    .lb-thumb {
      width: 52px;
      height: 36px;
    }

    /*
     * Capture data becomes a bottom sheet. A 250px side drawer on a 390px
     * screen would cover the photograph — the same overlap problem the desktop
     * drawer solves by pushing, in a room too small to push in.
     */
    .lb-exif {
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      width: auto;
      transform: translateY(100%);
      border-left: 0;
      border-right: 0;
      border-bottom: 0;
      padding: 18px var(--gutter) calc(24px + var(--lb-b));
      /*
       * Opaque, unlike the desktop drawer. That one is pushed clear of the
       * metadata stack; this one rises straight over it, and at 95% the title
       * and tags underneath still read straight through the panel.
       */
      background: var(--chrome);
    }

    .lb-exif.is-open {
      transform: none;
    }

    .lb-exif dl {
      gap: 9px 14px;
    }

    .lb-exif-close {
      display: block;
    }
  }

  @media (max-width: 720px) and (orientation: landscape) {
    .lb-stage {
      inset: calc(48px + var(--lb-t)) 0 calc(126px + var(--lb-b));
    }

    .lb-foot {
      padding-bottom: 10px;
    }

    .lb-title {
      font-size: 16px;
    }

    .lb-tags {
      display: none;
    }
  }

  /* ---------- 560: the phone read ----------
     RUNS goes to one column — on a phone the photograph should be the whole
     width, and the caption sits under it instead of on top of it. SHEET stays
     two-up: that view exists for scanning, not for looking. */
  @media (max-width: 560px) {
    .px-page {
      padding: 20px var(--gutter) 56px;
    }

    /* The bar is a mode switch you touch once. Pinning it costs a quarter of
       the screen on the view whose whole argument is that the photograph should
       own the width — so it scrolls away and only the run header stays. */
    .px-bar {
      position: static;
      margin-bottom: 18px;
    }

    .px-find {
      flex: 1 1 auto;
      order: 4;
    }

    .px-count {
      order: 5;
      margin-left: 0;
    }

    .px-sheet {
      column-count: 2;
      column-gap: 8px;
    }

    .px-sheet .px-tile {
      margin-bottom: 8px;
    }

    [data-sheet][data-layout='runs'] .px-sheet,
    [data-sheet][data-layout='editorial'] .px-sheet {
      column-count: 1;
    }

    [data-sheet][data-layout='runs'] .px-sheet .px-tile,
    [data-sheet][data-layout='editorial'] .px-sheet .px-tile {
      margin-bottom: 26px;
    }

    /* The caption steps out from under the frame and becomes type. */
    [data-sheet][data-layout='runs'] .px-cap,
    [data-sheet][data-layout='editorial'] .px-cap {
      position: static;
      opacity: 1;
      transform: none;
      padding: 9px 1px 0;
      text-shadow: none;
    }

    [data-sheet][data-layout='runs'] .px-cap-t,
    [data-sheet][data-layout='editorial'] .px-cap-t {
      font-size: 13px;
      color: var(--tx-hi);
    }

    [data-sheet][data-layout='runs'] .px-cap-m,
    [data-sheet][data-layout='editorial'] .px-cap-m {
      color: var(--dim);
    }

    [data-sheet][data-layout='runs'] .px-wash,
    [data-sheet][data-layout='editorial'] .px-wash {
      background: none;
    }

    /* Two-up is the scanning view; metadata would only get in the way. */
    [data-sheet][data-layout='sheet'] .px-cap {
      display: none;
    }

    .px-q {
      padding: 11px 13px;
      gap: 10px;
      flex-wrap: wrap;
      font-size: 9.5px;
    }
  }

  /* ---------- touch: nothing may hide behind a cursor ---------- */
  @media (hover: none) {
    .px-tile.is-in:hover {
      transform: none;
      box-shadow: none;
    }

    .px-tile:active {
      transform: scale(0.99);
    }

    .px-tile:hover .px-bracket,
    .px-tile:hover .px-idx {
      opacity: 0;
    }

    .px-tile:hover .px-wash {
      background: rgba(3, 4, 10, 0.18);
    }

    .px-seg button,
    .px-jump,
    .lb .btn-ghost {
      min-height: 44px;
    }
  }

  /* The gesture only replaces the arrows below 720, so the hint only shows there. */
  @media (hover: none) and (max-width: 720px) {
    .lb-swipe {
      display: block;
    }
  }
</style>
