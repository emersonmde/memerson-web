# Cache policy for Workers Static Assets (docs/PERFORMANCE.md §4.1).
#
# The platform default is `max-age=0, must-revalidate` on everything, which made
# the client router re-download fonts and icons on every navigation — six full
# 200s per asset in one measured session. Hashed bundles and fonts are immutable
# by construction; icons change rarely and can tolerate a day of staleness.
# HTML deliberately keeps the revalidate default — that is what makes deploys land.

# Baseline security headers on every response. Rules combine: a request
# matching several blocks gets the headers from all of them (same-named
# headers are joined, distinct names simply accumulate), so this block adds
# to the cache blocks below rather than replacing them. No CSP here — the
# build inlines scripts and styles, which makes a useful CSP non-trivial.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# `immutable` under unhashed filenames is a rename-to-change promise: these
# files are never edited in place — a font update must ship under a new
# filename, or clients holding the year-long cache never see it.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon-32x32.png
  Cache-Control: public, max-age=86400
/favicon-16x16.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/android-chrome-192x192.png
  Cache-Control: public, max-age=86400
/android-chrome-512x512.png
  Cache-Control: public, max-age=86400
/safari-pinned-tab.svg
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
